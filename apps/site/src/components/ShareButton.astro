---
interface Props {
  /** path of the page to share (defaults to the current page) */
  url?: string;
}

const { url } = Astro.props;
---

<button type="button" class="share-island" data-url={url}>
  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M6 8a2.5 2.5 0 0 1 2.5-2.5h3a2.5 2.5 0 0 1 0 5h-1M10 8a2.5 2.5 0 0 1-2.5 2.5h-3a2.5 2.5 0 0 1 0-5h1"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    />
  </svg>
  <span>Share</span>
</button>

<script>
  const flash = (button: HTMLElement, text: string): void => {
    const label = button.querySelector("span");
    if (!label) return;
    const original = label.textContent ?? "Share";
    label.textContent = text;
    setTimeout(() => {
      label.textContent = original;
    }, 1500);
  };

  document.querySelectorAll<HTMLButtonElement>(".share-island").forEach((button) => {
    if (button.dataset.shareBound) return;
    button.dataset.shareBound = "1";
    button.addEventListener("click", async () => {
      const target = new URL(button.dataset.url ?? window.location.pathname, window.location.origin).toString();
      if (navigator.share) {
        try {
          await navigator.share({ url: target, title: document.title });
          return;
        } catch {
          return; // user cancelled
        }
      }
      try {
        await navigator.clipboard.writeText(target);
        flash(button, "Copied!");
      } catch {
        flash(button, window.location.href);
      }
    });
  });
</script>

<style>
  .share-island {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.4rem;
    padding: 0 1rem;
    border: 1px solid var(--hairline);
    border-radius: 0.6rem;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
  }

  .share-island:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-tint);
  }
</style>
