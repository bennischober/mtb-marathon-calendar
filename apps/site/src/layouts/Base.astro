---
import "../styles/global.css";
import { buildDate, editions } from "../lib/catalog";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/", label: "Races" },
  { href: "/calendar", label: "Calendar" },
];

const upcoming = editions.filter((e) => e.date_start >= buildDate).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content={description ?? "An automated calendar of mountain bike marathon events."}
    />
  </head>
  <body class="min-h-screen bg-white text-stone-900 antialiased">
    <header class="site-header">
      <div class="header-bar">
        <a class="brand" href="/" aria-label="MTB Marathon Calendar home">
          <span class="brand-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 17.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm14 0a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z"
                fill="currentColor"
              />
              <path
                d="M5 15.5 9.5 7h2.8l3 5.5M12.3 7l3.2 8.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="brand-name">MTB Marathon Calendar</span>
        </a>
        <nav aria-label="Main">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <p class="header-stat">
          <strong>{upcoming}</strong> upcoming
        </p>
      </div>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Dates and details come from the sources listed on each event page.
        Corrections are welcome &mdash; every record keeps a link to the page
        it was read from.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #fff;
    color: #1c2724;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid #e7e5e0;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(8px);
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0.55rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    background: #2f6f5b;
    color: #fff;
  }

  .site-header nav {
    display: flex;
    gap: 0.15rem;
    margin-left: auto;
  }

  .site-header nav a {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    color: #52605b;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav a:hover {
    background: #f0eee7;
    color: #1c2724;
  }

  .site-header nav a[aria-current="page"] {
    background: #1c2724;
    color: #fff;
  }

  .header-stat {
    margin: 0;
    padding: 0.3rem 0.85rem;
    border: 1px solid #e7e5e0;
    border-radius: 999px;
    color: #52605b;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .header-stat strong {
    color: #2f6f5b;
    font-weight: 800;
  }

  @media (max-width: 40rem) {
    .brand-name {
      display: none;
    }

    .header-stat {
      display: none;
    }
  }

  .content {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  footer {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid #e7e5e0;
    color: #8a938e;
    font-size: 0.85rem;
  }

  a {
    color: #2f6f5b;
  }

  /* --- shared event card --- */
  .event-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid #e5e2da;
    border-radius: 1rem;
    background: #fff;
  }

  .event-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .event-heading h2,
  .event-heading h3 {
    margin: 0.2rem 0 0;
    font-size: 1.2rem;
  }

  .event-heading a {
    text-decoration: none;
  }

  .event-heading a:hover {
    text-decoration: underline;
  }

  .event-date {
    margin: 0;
    color: #52756a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .badge {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: #e5eee9;
    color: #2f5648;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .badge.kind {
    background: #e8e2f0;
    color: #4a3763;
  }

  .badge.unreviewed {
    background: #f6e6cf;
    color: #7a4f16;
  }

  .event-meta {
    margin: 0.6rem 0 0;
    color: #52605b;
    font-size: 0.95rem;
  }

  .course-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .course-list li {
    padding: 0.2rem 0.55rem;
    border-radius: 0.5rem;
    background: #f0eee7;
    font-size: 0.82rem;
  }

  .empty {
    padding: 2rem;
    border: 1px dashed #c9cfc7;
    border-radius: 1rem;
    color: #6b7673;
    text-align: center;
  }
</style>
