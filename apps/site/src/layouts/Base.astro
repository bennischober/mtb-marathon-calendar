---
import "../styles/global.css";
import { buildDate, editions } from "../lib/catalog";
import { withBase } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: withBase("/"), label: "Races" },
  { href: withBase("/calendar"), label: "Calendar" },
  { href: withBase("/finder"), label: "Find your race" },
  { href: withBase("/planner"), label: "Planner" },
  { href: withBase("/archive"), label: "Archive" },
];

const upcoming = editions.filter((e) => e.date_start >= buildDate).length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the theme: saved choice wins, else system preference.
      // Runs before first paint AND after every ClientRouter swap, because a
      // swapped-in <html> element carries no data-theme of its own.
      function applyTheme() {
        let saved = null;
        try {
          saved = localStorage.getItem("mtb-theme");
        } catch {}
        const theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
        return saved;
      }
      applyTheme();
      // No saved choice: follow live system changes until the user picks.
      const savedTheme = (() => {
        try {
          return localStorage.getItem("mtb-theme");
        } catch {
          return null;
        }
      })();
      if (savedTheme !== "light" && savedTheme !== "dark") {
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
          document.documentElement.dataset.theme = event.matches ? "dark" : "light";
        });
      }
    </script>
    <title>{title}</title>
    <meta
      name="description"
      content={description ?? "An automated calendar of mountain bike marathon events."}
    />
  </head>
  <body class="min-h-screen antialiased">
    <header class="site-header">
      <div class="header-bar">
        <a class="brand" href={withBase("/")} aria-label="MTB Marathon Calendar home">
          <span class="brand-mark" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d="M5 17.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm14 0a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z"
                fill="currentColor"
              />
              <path
                d="M5 15.5 9.5 7h2.8l3 5.5M12.3 7l3.2 8.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="brand-name">MTB Marathon Calendar</span>
        </a>
        <nav aria-label="Main">
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
              >
                {link.label}
                {link.href === withBase("/planner") && (
                  <span class="planner-badge" id="planner-count" hidden>0</span>
                )}
              </a>
            ))
          }
        </nav>
        <div class="header-end">
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            role="switch"
            aria-checked="false"
            aria-label="Dark mode"
            title="Switch between light and dark"
          >
            <span class="toggle-thumb"></span>
            <svg class="icon-sun" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="3.2" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M13 3l-1.4 1.4M4.4 11.6 3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg class="icon-moon" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </button>
          <p class="header-stat">
            <strong>{upcoming}</strong> upcoming
          </p>
        </div>
      </div>
    </header>

    <main class="content">
      <slot />
    </main>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        const toggle = document.getElementById("theme-toggle");
        toggle?.setAttribute("aria-checked", String(next === "dark"));
        try {
          localStorage.setItem("mtb-theme", next);
        } catch {}
      });
    </script>
    <footer class="site-footer">
      <p>
        Dates and details come from the sources listed on each event page.
        Corrections are welcome &mdash; every record keeps a link to the page
        it was read from.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 0.55rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.98rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    background: var(--accent);
    color: #fff;
  }

  .site-header nav {
    display: flex;
    gap: 0.15rem;
    margin-left: auto;
  }

  .site-header nav a {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav a:hover {
    background: var(--bg-tint);
    color: var(--text);
  }

  .site-header nav a[aria-current="page"] {
    background: var(--text);
    color: var(--bg);
  }

  .planner-badge {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: #b98a1c;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .site-header nav {
    margin-left: 0;
  }

  .header-stat {
    margin: 0;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--text-soft);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .header-stat strong {
    color: var(--accent);
    font-weight: 800;
  }

  @media (max-width: 40rem) {
    .brand-name,
    .header-stat {
      display: none;
    }
  }

  .planner-badge {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--pin);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }

  .site-header nav {
    margin-left: 0;
  }

  /* A two-state track switch: sun left, moon right, thumb slides.
     Both icons always visible — the position shows the state, so the
     control teaches itself. */
  .theme-toggle {
    position: relative;
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    width: 3.4rem;
    height: 1.75rem;
    padding: 0 0.4rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--bg-tint);
    color: var(--text-mute);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--text-soft);
  }

  .toggle-thumb {
    position: absolute;
    top: 0.14rem;
    left: 0.16rem;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--hairline);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--text) 12%, transparent);
    transition: transform 0.18s ease, background 0.15s ease;
  }

  html[data-theme="dark"] .toggle-thumb {
    transform: translateX(1.6rem);
    background: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle .icon-sun,
  .theme-toggle .icon-moon {
    position: relative;
    z-index: 1;
    transition: color 0.15s ease;
  }

  html[data-theme="light"] .theme-toggle .icon-sun {
    color: var(--accent);
  }

  html[data-theme="dark"] .theme-toggle .icon-moon {
    color: #fff;
  }

  .content {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 4rem;
  }

  footer {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--hairline);
    color: var(--text-mute);
    font-size: 0.85rem;
  }

  a {
    color: var(--accent);
  }

  /* --- shared event card --- */
  .event-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: var(--surface);
  }

  .event-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .event-heading h2,
  .event-heading h3 {
    margin: 0.2rem 0 0;
    font-size: 1.2rem;
  }

  .event-heading a {
    text-decoration: none;
  }

  .event-heading a:hover {
    text-decoration: underline;
  }

  .event-date {
    margin: 0;
    color: #52756a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .badge {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .badge.kind {
    background: #e8e2f0;
    color: #4a3763;
  }

  .badge.unreviewed {
    background: #f6e6cf;
    color: #7a4f16;
  }

  .event-meta {
    margin: 0.6rem 0 0;
    color: var(--text-soft);
    font-size: 0.95rem;
  }

  .course-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .course-list li {
    padding: 0.2rem 0.55rem;
    border-radius: 0.5rem;
    background: #f0eee7;
    font-size: 0.82rem;
  }

  .empty {
    padding: 2rem;
    border: 1px dashed var(--hairline);
    border-radius: 1rem;
    color: var(--text-mute);
    text-align: center;
  }
</style>
