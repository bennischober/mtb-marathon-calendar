{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mtb-marathon-calendar/event.schema.json",
  "title": "MTB Marathon Event Edition",
  "description": "A year-specific mountain bike marathon event edition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "event_id",
    "edition",
    "name",
    "date_start",
    "format",
    "location",
    "course_variants",
    "official_url",
    "source_refs",
    "classification",
    "classification_confidence",
    "review",
    "status"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "edition": {"type": "integer", "minimum": 1900, "maximum": 2200},
    "name": {"type": "string", "minLength": 1},
    "date_start": {"type": "string", "format": "date"},
    "date_end": {"type": "string", "format": "date"},
    "format": {
      "type": "string",
      "enum": ["single_day", "point_to_point", "stage_race", "multi_day"]
    },
    "duration_days": {"type": "integer", "minimum": 1},
    "location": {"$ref": "#/$defs/location"},
    "course_variants": {
      "type": "array",
      "items": {"$ref": "#/$defs/course_variant"}
    },
    "previous_edition_id": {"type": "string", "minLength": 1},
    "official_url": {"type": "string", "format": "uri"},
    "registration_url": {"type": "string", "format": "uri"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "classification": {
      "type": "string",
      "enum": [
        "mtb_marathon",
        "mtb_stage_race",
        "mtb_point_to_point",
        "mtb_candidate",
        "exclude"
      ]
    },
    "classification_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "extraction_warnings": {"type": "array", "items": {"type": "string"}},
    "editorial_profile": {"$ref": "#/$defs/editorial_profile"},
    "review": {"$ref": "#/$defs/review"},
    "status": {
      "type": "string",
      "enum": ["announced", "active", "registration_open", "sold_out", "cancelled", "postponed", "unknown"]
    },
    "last_verified": {"type": "string", "format": "date"}
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "country"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "region": {"type": "string"},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "course_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "distance_km", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "distance_km": {"type": "number", "exclusiveMinimum": 0},
        "elevation_m": {"type": "number", "minimum": 0},
        "start_location": {"type": "string"},
        "finish_location": {"type": "string"},
        "technical_notes": {"type": "string"},
        "availability": {
          "type": "string",
          "enum": ["confirmed", "announced", "unknown", "sold_out", "cancelled"]
        },
        "status": {
          "type": "string",
          "enum": ["announced", "active", "registration_open", "sold_out", "cancelled", "postponed", "unknown"]
        },
        "source_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "retrieved_at", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "supports": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "content_hash": {"type": "string"},
        "native_id": {"type": "string"},
        "adapter": {"type": "string"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unreviewed", "approved", "rejected", "false_positive"]
        },
        "reason": {"type": "string"},
        "reviewed_by": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "editorial_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {"type": "string"},
        "route_character": {"type": "string"},
        "scenery": {"type": "string"},
        "organization": {"type": "string"},
        "technical_difficulty": {"type": "string"},
        "contributor": {"type": "string"},
        "source_refs": {"type": "array", "items": {"type": "string"}},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}