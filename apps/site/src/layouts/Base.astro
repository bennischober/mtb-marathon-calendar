---
import "../styles/global.css";
import { editions } from "../lib/catalog";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: "/", label: "List" },
  { href: "/calendar", label: "Calendar" },
];

const upcoming = editions.filter((e) => e.date_start >= "2026-01-01").length;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content={description ?? "An automated calendar of mountain bike marathon events."}
    />
  </head>
  <body class="min-h-screen bg-gradient-to-b from-stone-50 to-stone-100 text-stone-900 antialiased">
    <header class="site-header">
      <div class="wrap max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="eyebrow">Automated-first race discovery</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance"><a href="/">MTB Marathon Calendar</a></h1>
        <nav aria-label="Main" class="flex flex-wrap gap-2 mt-4">
          {
            links.map((link) => (
              <a href={link.href} aria-current={path === link.href ? "page" : undefined} class="px-4 py-1.5 rounded-full border border-stone-300 bg-white/90 hover:bg-white transition text-sm font-medium shadow-sm">
                {link.label}
              </a>
            ))
          }
        </nav>
        <p class="lede text-pretty text-stone-700 max-w-3xl mt-4">
          Mountain bike marathon, ultra and epic events collected from public sources.
          <a href="/calendar" class="underline decoration-stone-400 hover:decoration-stone-600">Browse the calendar</a> or filter the
          <a href="/" class="underline decoration-stone-400 hover:decoration-stone-600">full list</a> by country and format. {upcoming} editions from this
          season.
        </p>
      </div>
    </header>

    <main class="wrap max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="wrap max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-stone-600 text-sm">
      <p>
        Dates and details come from the sources listed on each event page. Corrections are
        welcome &mdash; every record keeps a link to the page it was read from.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f5f3ee;
    color: #1c2724;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }

  .wrap {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .site-header {
    padding: 3rem 0 1.5rem;
  }

  .site-header .eyebrow {
    margin: 0;
    color: #52756a;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-header h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .site-header h1 a {
    color: inherit;
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .site-header nav a {
    padding: 0.3rem 0.85rem;
    border: 1px solid #d9ded8;
    border-radius: 999px;
    background: #fffefa;
    color: #2f6f5b;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav a[aria-current="page"] {
    background: #2f6f5b;
    border-color: #2f6f5b;
    color: #fffefa;
  }

  .lede {
    max-width: 42rem;
    margin: 0;
    color: #52605b;
  }

  main {
    padding-bottom: 4rem;
  }

  footer {
    padding-bottom: 3rem;
    color: #6b7673;
    font-size: 0.9rem;
  }

  a {
    color: #2f6f5b;
  }

  /* --- shared event card --- */
  .event-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid #d9ded8;
    border-radius: 1rem;
    background: #fffefa;
  }

  .event-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .event-heading h2,
  .event-heading h3 {
    margin: 0.2rem 0 0;
    font-size: 1.2rem;
  }

  .event-heading a {
    text-decoration: none;
  }

  .event-heading a:hover {
    text-decoration: underline;
  }

  .event-date {
    margin: 0;
    color: #52756a;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .badge {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: #e5eee9;
    color: #2f5648;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .badge.kind {
    background: #e8e2f0;
    color: #4a3763;
  }

  .badge.unreviewed {
    background: #f6e6cf;
    color: #7a4f16;
  }

  .event-meta {
    margin: 0.6rem 0 0;
    color: #52605b;
    font-size: 0.95rem;
  }

  .course-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .course-list li {
    padding: 0.2rem 0.55rem;
    border-radius: 0.5rem;
    background: #f0eee7;
    font-size: 0.82rem;
  }

  .empty {
    padding: 2rem;
    border: 1px dashed #c9cfc7;
    border-radius: 1rem;
    color: #6b7673;
    text-align: center;
  }
</style>