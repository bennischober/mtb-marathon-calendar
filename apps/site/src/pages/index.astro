---
import Base from "../layouts/Base.astro";
import {
  buildDate,
  classifications,
  countries,
  editions,
  editionTotalDays,
  futureEditions,
  generatedAt,
  kinds,
  monthGroups,
  searchHaystack,
} from "../lib/catalog";
import { formatCourseLabel, formatDateRange, formatDistance, formatKind, formatTimestamp } from "../lib/format";

const months = monthGroups();
const visible = futureEditions;
---

<Base
  title="All races — MTB Marathon Calendar"
  description="Every mountain bike marathon, ultra and stage race we have collected, filterable by country, format and month."
>
  <section
    class="filters sticky top-0 z-10 rounded-2xl border border-stone-200 bg-white/95 px-4 py-4 shadow-sm backdrop-blur"
    aria-labelledby="filters-heading"
  >
    <h2 id="filters-heading" class="sr-only">Filter races</h2>

    <div class="filter-row">
      <label class="search">
        <span class="filter-label">Search <kbd title="Press / to focus">/</kbd></span>
        <input
          type="search"
          id="search"
          placeholder="Race name or place"
          autocomplete="off"
        />
      </label>

      <fieldset>
        <legend class="filter-label">
          Country
          <span class="legend-actions">
            <button type="button" class="mini" data-all="country">All</button>
            <button type="button" class="mini" data-none="country">None</button>
          </span>
        </legend>
        <div class="chips">
          {
            countries.map((code) => (
              <label class="chip">
                <input type="checkbox" name="country" value={code} checked />
                <span>{code}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">
          Format
          <span class="legend-actions">
            <button type="button" class="mini" data-all="format">All</button>
            <button type="button" class="mini" data-none="format">None</button>
          </span>
        </legend>
        <div class="chips">
          {
            kinds.map((kind) => (
              <label class="chip">
                <input type="checkbox" name="format" value={kind.value} checked />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">
          Class
          <span class="legend-actions">
            <button type="button" class="mini" data-all="class">All</button>
            <button type="button" class="mini" data-none="class">None</button>
          </span>
        </legend>
        <div class="chips">
          {
            classifications.map((kind) => (
              <label class="chip">
                <input type="checkbox" name="class" value={kind.value} checked />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">
          Review
          <span class="legend-actions">
            <button type="button" class="mini" data-all="review">All</button>
            <button type="button" class="mini" data-none="review">None</button>
          </span>
        </legend>
        <div class="chips">
          <label class="chip">
            <input type="checkbox" name="review" value="unreviewed" checked />
            <span>Unreviewed</span>
          </label>
          <label class="chip">
            <input type="checkbox" name="review" value="approved" checked />
            <span>Approved</span>
          </label>
        </div>
      </fieldset>

      <label class="month">
        <span class="filter-label">Month</span>
        <select id="month">
          <option value="">All months</option>
          {months.map((group) => <option value={group.key}>{group.label}</option>)}
        </select>
      </label>

      <label class="sort">
        <span class="filter-label">Sort</span>
        <select id="sort">
          <option value="date">Soonest first</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>

      <button type="button" id="reset">Reset</button>
    </div>

    <p class="result-count" id="result-count" role="status" aria-live="polite">
      Showing {visible.length} of {visible.length} upcoming races
      <label class="past-toggle">
        <input type="checkbox" id="show-past" />
        <span>Show past races</span>
      </label>
    </p>
  </section>

  <ul class="event-list" id="event-list">
    {
      visible.map((edition) => {
        const end = (edition as { date_end?: string | null }).date_end ?? undefined;
        const days = editionTotalDays(edition);
        return (
          <li
            class="event-card"
            data-country={edition.location.country}
            data-format={edition.format}
            data-class={edition.classification}
            data-month={edition.date_start.slice(0, 7)}
            data-review={edition.review.status}
            data-search={searchHaystack(edition)}
            data-name={edition.name.toLowerCase()}
            data-date={edition.date_start}
            data-end={(edition as { date_end?: string | null }).date_end ?? edition.date_start}
          >
            <div class="event-heading">
              <div class="min-w-0">
                <p class="event-date">
                  {formatDateRange(edition.date_start, end)}
                  {days > 1 && <span class="days-pill">{days} days</span>}
                </p>
                <h2>
                  <a href={`/events/${edition.id}`}>{edition.name}</a>
                </h2>
              </div>
              <div class="badges">
                <span class="badge kind">{formatKind(edition.format)}</span>
                {edition.classification === "mtb_ultra" && (
                  <span class="badge ultra">Ultra</span>
                )}
                <span class="badge">{edition.location.country}</span>
                {edition.review.status !== "approved" && (
                  <span class="badge unreviewed">{edition.review.status}</span>
                )}
              </div>
            </div>

            <p class="event-meta">
              {edition.location.name}
              {edition.location.region ? `, ${edition.location.region}` : ""}
              {" · "}
              <a href={edition.official_url} target="_blank" rel="noopener noreferrer">Official page ↗</a>
            </p>

            {edition.course_variants.length > 0 && (
              <ul class="course-list">
                {edition.course_variants.map((course) => (
                  <li>
                    {formatCourseLabel(course.name, course.distance_km)}
                  </li>
                ))}
              </ul>
            )}

            <p class="card-foot">
              <a href={`/events/${edition.id}`} aria-label={`Details for ${edition.name}`}>
                View details →
              </a>
            </p>
          </li>
        );
      })
    }
  </ul>

  <p class="empty" id="no-results" hidden>
    No races match those filters. <button type="button" id="reset-2">Reset them</button>
  </p>

  <p class="generated">Data collected {formatTimestamp(generatedAt)}.</p>
</Base>

<script>
  const list = document.querySelector<HTMLUListElement>("#event-list");
  const cards = Array.from(list?.querySelectorAll<HTMLElement>(".event-card") ?? []);
  const search = document.querySelector<HTMLInputElement>("#search");
  const month = document.querySelector<HTMLSelectElement>("#month");
  const sort = document.querySelector<HTMLSelectElement>("#sort");
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#no-results");

  const checked = (name: string): string[] =>
    Array.from(
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`),
    ).map((input) => input.value);

  const showPast = document.querySelector<HTMLInputElement>("#show-past");

  function apply(): void {
    const countriesWanted = checked("country");
    const formatsWanted = checked("format");
    const classesWanted = checked("class");
    const reviewsWanted = checked("review");
    const monthWanted = month?.value ?? "";
    const query = (search?.value ?? "").trim().toLowerCase();
    const includePast = showPast?.checked ?? false;

    let shown = 0;
    for (const card of cards) {
      const isPast = (card.dataset.end ?? "") < new Date().toISOString().slice(0, 10);
      const matches =
        countriesWanted.includes(card.dataset.country ?? "") &&
        formatsWanted.includes(card.dataset.format ?? "") &&
        classesWanted.includes(card.dataset.class ?? "") &&
        reviewsWanted.includes(card.dataset.review ?? "") &&
        (!monthWanted || card.dataset.month === monthWanted) &&
        (!query || (card.dataset.search ?? "").includes(query)) &&
        (includePast || !isPast);
      card.hidden = !matches;
      if (matches) shown += 1;
    }

    if (count) {
      count.textContent = `Showing ${shown} of ${cards.length} races`;
    }
    if (empty) empty.hidden = shown > 0;
  }

  function sortCards(): void {
    if (!list) return;
    const mode = sort?.value ?? "date";
    const visible = cards.filter((card) => !card.hidden);
    const hidden = cards.filter((card) => card.hidden);
    const ordered = [...visible].sort((a, b) =>
      mode === "name"
        ? (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
        : (a.dataset.date ?? "").localeCompare(b.dataset.date ?? ""),
    );
    for (const card of [...ordered, ...hidden]) list.appendChild(card);
  }

  function applyAndSort(): void {
    apply();
    sortCards();
  }

  function reset(): void {
    if (search) search.value = "";
    if (month) month.value = "";
    if (sort) sort.value = "date";
    for (const input of document.querySelectorAll<HTMLInputElement>(
      'input[name="country"], input[name="format"], input[name="class"], input[name="review"]',
    )) {
      input.checked = true;
    }
    if (showPast) showPast.checked = false;
    applyAndSort();
  }

  search?.addEventListener("input", apply);
  month?.addEventListener("change", apply);
  sort?.addEventListener("change", sortCards);
  document
    .querySelectorAll<HTMLInputElement>('input[name="country"], input[name="format"], input[name="class"], input[name="review"]')
    .forEach((input) => input.addEventListener("change", apply));
  showPast?.addEventListener("change", apply);

  document.querySelectorAll<HTMLButtonElement>("button[data-all]").forEach((button) => {
    button.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLInputElement>(`input[name="${button.dataset.all}"]`)
        .forEach((input) => {
          input.checked = true;
        });
      apply();
    });
  });
  document.querySelectorAll<HTMLButtonElement>("button[data-none]").forEach((button) => {
    button.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLInputElement>(`input[name="${button.dataset.none}"]`)
        .forEach((input) => {
          input.checked = false;
        });
      apply();
    });
  });
  document.querySelector("#reset")?.addEventListener("click", reset);
  document.querySelector("#reset-2")?.addEventListener("click", reset);

  window.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "SELECT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable);
    if (event.key === "/" && !typing) {
      event.preventDefault();
      search?.focus();
    } else if (event.key === "Escape" && document.activeElement === search) {
      if (search.value) {
        search.value = "";
        apply();
      } else {
        search.blur();
      }
    }
  });
</script>

<style>
  /* Unlayered page styles intentionally override the shared cream theme:
     Tailwind v4 emits utilities into @layer utilities, and unlayered author
     CSS wins over layered CSS, so the real look has to live here. */

  .filters {
    margin-bottom: 1.75rem;
    padding: 1.1rem 1.25rem 1rem;
    border: 1px solid #e5e1d5;
    border-radius: 1.25rem;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgb(28 39 36 / 0.05),
      0 12px 32px -20px rgb(28 39 36 / 0.25);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem 1.25rem;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-label {
    display: block;
    margin-bottom: 0.35rem;
    color: #5b6660;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .filter-label kbd {
    padding: 0 0.35rem;
    border: 1px solid #d9ded8;
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    background: #f0eee7;
    font-size: 0.68rem;
    letter-spacing: 0;
  }

  .search {
    flex: 1 1 240px;
    min-width: min(240px, 100%);
  }

  .search input {
    width: 100%;
    height: 2.75rem;
    font-size: 1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.85rem;
    border: 1px solid #d9ded8;
    border-radius: 999px;
    background: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .chip:hover {
    border-color: #9db8ac;
    transform: translateY(-1px);
  }

  .chip:focus-within {
    outline: 2px solid #2f6f5b;
    outline-offset: 2px;
  }

  .chip:has(input:checked) {
    border-color: #2f6f5b;
    background: #e2efe8;
    color: #24493c;
    font-weight: 700;
  }

  .chip input {
    margin: 0;
    accent-color: #2f6f5b;
  }

  input[type="search"],
  select {
    padding: 0.4rem 0.7rem;
    border: 1px solid #d9ded8;
    border-radius: 0.75rem;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
  }

  select {
    height: 2.75rem;
  }

  input[type="search"]:focus,
  select:focus {
    outline: 2px solid #2f6f5b;
    outline-offset: 1px;
    border-color: #2f6f5b;
  }

  input[type="search"]:focus {
    box-shadow: 0 0 0 4px rgb(47 111 91 / 0.12);
  }

  #reset {
    height: 2.75rem;
    padding: 0 1.4rem;
    border: 1px solid #2f6f5b;
    border-radius: 999px;
    background: #2f6f5b;
    color: #fffefa;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }

  #reset:hover {
    background: #265a49;
    transform: translateY(-1px);
  }

  .result-count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin: 0.9rem 0 0;
    color: #5b6660;
    font-size: 0.9rem;
  }

  .past-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    cursor: pointer;
    color: #52605b;
  }

  .past-toggle input {
    margin: 0;
    accent-color: #2f6f5b;
  }

  .legend-actions {
    display: inline-flex;
    gap: 0.25rem;
    margin-left: 0.4rem;
  }

  button.mini {
    padding: 0 0.45rem;
    border: 1px solid #d9ded8;
    border-radius: 0.35rem;
    background: #f7f5ef;
    color: #52605b;
    font-size: 0.68rem;
    font-weight: 700;
    cursor: pointer;
  }

  button.mini:hover {
    background: #e5eee9;
    border-color: #9db8ac;
  }

  .event-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 62rem) {
    .event-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .event-list .event-card {
    --accent: #2f6f5b;
    position: relative;
    overflow: hidden;
    padding: 1.3rem 1.4rem 1.15rem 1.6rem;
    border: 1px solid #e5e1d5;
    border-radius: 1.15rem;
    background: #ffffff;
    box-shadow:
      0 1px 2px rgb(28 39 36 / 0.06),
      0 10px 28px -18px rgb(28 39 36 / 0.35);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .event-list .event-card::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 5px;
    background: var(--accent);
  }

  .event-list .event-card[data-format="stage_race"] {
    --accent: #6d4fc2;
  }

  .event-list .event-card[data-format="point_to_point"] {
    --accent: #2563eb;
  }

  .event-list .event-card[data-format="multi_day"] {
    --accent: #b45309;
  }

  .event-list .event-card:hover {
    transform: translateY(-3px);
    border-color: #cfcaba;
    box-shadow:
      0 2px 4px rgb(28 39 36 / 0.07),
      0 18px 40px -20px rgb(28 39 36 / 0.4);
  }

  .event-list .event-card:hover .event-heading h2 a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-card[hidden] {
    display: none;
  }

  .event-list .event-date {
    color: #2f6f5b;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-list .days-pill {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.12rem 0.6rem;
    border-radius: 999px;
    background: #e2efe8;
    color: #24493c;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: none;
    vertical-align: 1px;
  }

  .event-list .event-heading h2 {
    margin: 0.35rem 0 0;
    font-size: 1.3rem;
    font-weight: 750;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .event-list .event-heading h2 a {
    color: #1c2724;
    text-decoration: none;
  }

  .event-list .badges .badge {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.24rem 0.65rem;
  }

  .event-list .badges .badge.kind {
    background: #ece7f7;
    color: #46336b;
  }

  .event-list .badges .badge.ultra {
    background: #fde8e8;
    color: #8a2f2f;
  }

  .badge.ultra {
    background: #fde8e8;
    color: #8a2f2f;
  }

  .event-list .badges .badge:not(.kind):not(.unreviewed) {
    background: #edf0eb;
    color: #3f4a45;
  }

  .event-list .badges .badge.unreviewed {
    background: #f7e6c3;
    color: #7a4f16;
  }

  .event-list .event-meta {
    margin: 0.55rem 0 0;
    color: #52605b;
    font-size: 0.93rem;
  }

  .event-list .course-list li {
    border: 1px solid #e7e3d6;
    background: #f4f2ea;
    font-weight: 500;
  }

  .event-list .card-foot {
    margin: 0.85rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid #efe9db;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .event-list .card-foot a {
    color: #2f6f5b;
    text-decoration: none;
  }

  .event-list .card-foot a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-list .card-foot a:focus-visible,
  .event-list .event-heading h2 a:focus-visible,
  .event-list .event-meta a:focus-visible {
    outline: 2px solid #2f6f5b;
    outline-offset: 2px;
    border-radius: 4px;
  }

  .empty {
    padding: 2.5rem 2rem;
    background: #fff;
  }

  .empty button {
    padding: 0.35rem 0.9rem;
    border: 1px solid #2f6f5b;
    border-radius: 999px;
    background: #2f6f5b;
    color: #fffefa;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .generated {
    margin-top: 1.5rem;
    color: #6b7673;
    font-size: 0.85rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
