---
import Base from "../../../layouts/Base.astro";
import PinButton from "../../../components/PinButton.astro";
import Countdown from "../../../components/Countdown.astro";
import ShareButton from "../../../components/ShareButton.astro";
import {
  editions,
  editionById,
  editionsForEvent,
  hasNewerEdition,
  latestEditionFor,
  nearbyEditions,
  slugForEvent,
} from "../../../lib/catalog";
import {
  countryFlag,
  formatCourseLabel,
  formatDate,
  formatDateCompact,
  formatDateRange,
  formatDistance,
  formatElevation,
  formatKind,
  formatTimestamp,
  yearOf,
} from "../../../lib/format";

// One static page per exported edition, generated from the catalog so a new
// edition needs no change here.
export function getStaticPaths() {
  const seen = new Set<string>();
  return editions
    .filter((edition) => {
      // One page per (slug, year): two sources' editions of the same series
      // in one year collapse onto the merged record we publish.
      const key = `${edition.event_id}-${edition.edition}`;
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    })
    .map((edition) => ({
      params: {
        slug: slugForEvent(edition.event_id),
        year: String(edition.edition),
      },
      props: { editionId: edition.id },
    }));
}

interface Props {
  editionId: string;
}

const { editionId } = Astro.props;
const edition = editionById(editionId);

if (!edition) {
  // Unreachable for generated pages, but keeps the type narrow.
  throw new Error(`no edition with id ${id}`);
}

const siblings = editionsForEvent(edition.event_id).filter((e) => e.id !== edition.id);
const newer = latestEditionFor(edition.event_id);
const newerExists = hasNewerEdition(edition);
const nearby = nearbyEditions(edition);
const hasCoordinates = edition.location.lat !== null && edition.location.lng !== null;
const mapUrl = hasCoordinates
  ? `https://www.openstreetmap.org/?mlat=${edition.location.lat}&mlon=${edition.location.lng}#map=13/${edition.location.lat}/${edition.location.lng}`
  : null;
const latestRead = edition.source_refs.reduce<string>(
  (latest, ref) => (ref.retrieved_at > latest ? ref.retrieved_at : latest),
  "",
);
const priceReadAt = (() => {
  const organizerRef = edition.source_refs.find((ref) => ref.adapter === "organizer");
  const reference = organizerRef ?? edition.source_refs[0];
  return reference?.retrieved_at?.slice(0, 10) ?? "";
})();
const longest = edition.course_variants.length
  ? Math.max(...edition.course_variants.map((course) => course.distance_km))
  : null;
---

<Base title={`${edition.name} — MTB Marathon Calendar`}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsEvent",
      name: edition.name,
      startDate: edition.date_start,
      ...(edition.date_end ? { endDate: edition.date_end } : {}),
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      location: {
        "@type": "Place",
        name: edition.location.name,
        address: {
          "@type": "PostalAddress",
          addressCountry: edition.location.country,
          ...(edition.location.region ? { addressRegion: edition.location.region } : {}),
        },
        ...(hasCoordinates
          ? { geo: { "@type": "GeoCoordinates", latitude: edition.location.lat, longitude: edition.location.lng } }
          : {}),
      },
      organizer: { "@type": "Organization", name: edition.name, url: edition.official_url },
      url: edition.official_url,
    })}
  />
  <article class="event">
    <header class="event-hero">
      <div class="hero-rail" aria-hidden="true">
        <span class="flag">{countryFlag(edition.location.country)}</span>
        <span class="rail-date">{formatDateCompact(edition.date_start)}</span>
        <span class="rail-year">{yearOf(edition.date_start)}</span>
      </div>

      <div class="hero-body">
        <p class="crumbs">
          <a href="/">Races</a>
          <span aria-hidden="true">/</span>
          <a href={`/events/${slugForEvent(edition.event_id)}`}>Series</a>
          <span aria-hidden="true">/</span>
          <span>{edition.edition}</span>
        </p>
        <Countdown date={edition.date_start} />
        {
          newerExists && newer && (
            <p class="newer-note">
              A newer edition ({newer.edition}) is known —{" "}
              <a href={`/events/${slugForEvent(newer.event_id)}/${newer.edition}`}>open it</a>{" "}
              or see the{" "}
              <a href={`/events/${slugForEvent(edition.event_id)}`}>series page</a>.
            </p>
          )
        }
        <h1>{edition.name}</h1>

        <div class="badges">
          <span class="badge kind">{formatKind(edition.format)}</span>
          {edition.classification === "mtb_ultra" && (
            <span class="badge ultra">Ultra</span>
          )}
          {edition.duration_days !== null && edition.duration_days > 1 && (
            <span class="badge">{edition.duration_days} days</span>
          )}
          {edition.status !== "unknown" && (
            <span class="badge">{edition.status.replaceAll("_", " ")}</span>
          )}

        </div>

        <p class="hero-meta">
          {edition.location.name}
          {edition.location.region ? `, ${edition.location.region}` : ""}
          {longest !== null && ` · up to ${formatDistance(longest)}`}
          {edition.start_time && ` · start ${edition.start_time}`}
        </p>

        <p class="actions">
          <PinButton editionId={edition.id} name={edition.name} />
          <a class="btn" href={`/events/${slugForEvent(edition.event_id)}-${edition.edition}.ics`} download>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1.5" y="3" width="13" height="11.5" rx="2" stroke="currentColor" stroke-width="1.4" />
              <path d="M1.5 6.5h13M5 1.5v3M11 1.5v3" stroke="currentColor" stroke-width="1.4" />
            </svg>
            <span>Calendar</span>
          </a>
          <ShareButton url={`/events/${slugForEvent(edition.event_id)}/${edition.edition}`} />
          <a class="btn primary" href={edition.official_url} target="_blank" rel="noopener noreferrer">
            Official page ↗
          </a>
          {
            edition.registration_url && (
              <a class="btn" href={edition.registration_url} target="_blank" rel="noopener noreferrer">
                Registration ↗
              </a>
            )
          }
          {
            mapUrl && (
              <a class="btn" href={mapUrl} target="_blank" rel="noopener noreferrer">
                Map ↗
              </a>
            )
          }
        </p>
      </div>
    </header>

    {edition.description && (
      <section>
        <h2 class="section-title">About the race</h2>
        <p class="about">{edition.description}</p>
        <p class="note">From the organizer's page — not our wording.</p>
      </section>
    )}

    <section>
      <h2 class="section-title">Courses</h2>
      {
        edition.course_variants.length > 0 ? (
          <ul class="course-cards">
            {edition.course_variants.map((course) => (
              <li class="course-card">
                <p class="course-distance">{formatDistance(course.distance_km)}</p>
                {formatCourseLabel(course.name, course.distance_km) !== formatDistance(course.distance_km) && (
                  <p class="course-name">{formatCourseLabel(course.name, course.distance_km)}</p>
                )}
                <p class="course-detail">
                  {course.elevation_m ? `${formatElevation(course.elevation_m)} elevation` : "—"}
                  {(course.start_location || course.finish_location) &&
                    ` · ${course.start_location || "?"} → ${course.finish_location || "?"}`}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">
            No source has published a distance for this race. The gap is shown rather than
            filled with a guessed figure, until a source or organiser confirms it.
          </p>
        )
      }
    </section>

    {
      (edition.prices?.length ?? 0) > 0 && (
        <section>
          <h2 class="section-title">Entry prices</h2>
          <p class="price-note">
            As published by the organiser; tiers often relate to registration
            windows or packages. Always confirm on the official page.
          </p>
          <ul class="price-list">
            {(edition.prices ?? []).slice(0, 8).map((price) => (
              <li class="price-row">
                <span class="price-amount">{price.amount}</span>
                {price.label && <span class="price-label">{price.label}</span>}
                {price.note && <span class="price-note-inline">{price.note}</span>}
                {price.valid_until && (
                  <span class="price-note-inline">until {formatDate(price.valid_until)}</span>
                )}
              </li>
            ))}
          </ul>
          <p class="price-freshness">
            Prices read{" "}
            {formatDate(priceReadAt)} — they change often and tiers may have
            expired. Always confirm on the{" "}
            <a href={edition.official_url} target="_blank" rel="noopener noreferrer">
              official page
            </a>.
          </p>
        </section>
      )
    }

    <section>
      <h2 class="section-title">Where</h2>
      <p class="where">
        {edition.location.name}
        {edition.location.region ? `, ${edition.location.region}` : ""}
        {", "}
        {edition.location.country}
      </p>
      {
        !hasCoordinates && (
          <p class="note">
            No source publishes exact coordinates for this race, so the place above is the
            region the federation or organiser listed rather than a verified venue.
          </p>
        )
      }
    </section>

    {
      nearby.length > 0 && (
        <section>
          <h2 class="section-title">Same week, nearby</h2>
          <p class="note">
            Other races within ±7 days worth combining into one trip, nearest
            first when coordinates are known.
          </p>
          <ul class="nearby-list">
            {nearby.map(({ edition: other, daysAway, proximityKm }) => (
              <li>
                <a href={`/events/${slugForEvent(other.event_id)}/${other.edition}`}>
                  {other.name}
                </a>
                <span class="note">
                  {daysAway === 0
                    ? "same day"
                    : daysAway === 1
                      ? "1 day away"
                      : `${daysAway} days away`}
                  {proximityKm !== null && ` · ${Math.round(proximityKm)} km away`}
                  {" · "}
                  {other.date_start}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2 class="section-title">Where this came from</h2>
      <p class="note">Most recently read {formatTimestamp(latestRead)}.</p>
      <ul class="sources">
        {
          edition.source_refs.map((ref) => (
            <li class="source-row">
              <a href={ref.url} target="_blank" rel="noopener noreferrer">
                {ref.adapter ?? "source"} ↗
              </a>
              <span class="note">
                read {formatTimestamp(ref.retrieved_at)} · confidence{" "}
                {Math.round(ref.confidence * 100)}%
                {ref.supports.length > 0 && ` · used for ${ref.supports.join(", ")}`}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      siblings.length > 0 && (
        <section>
          <h2 class="section-title">Other editions</h2>
          <ul class="siblings">
            {siblings.map((other) => (
              <li>
                <a href={`/events/${other.id}`}>
                  <span class="flag small" aria-hidden="true">
                    {countryFlag(other.location.country)}
                  </span>
                  {formatDate(other.date_start)} — {other.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>



<style>
  .event {
    max-width: 48rem;
  }

  /* Hero: the same scan rail as the list cards, scaled up */
  .event-hero {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    margin-bottom: 2rem;
    border: 1px solid #e5e2da;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1px 2px rgb(28 39 36 / 0.05);
    overflow: hidden;
  }

  .hero-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 1.1rem 0.5rem;
    border-right: 1px solid #efede6;
    background: #faf9f6;
  }

  .hero-rail .flag {
    font-size: 2.2rem;
    line-height: 1.1;
  }

  .hero-rail .rail-date {
    margin-top: 0.4rem;
    color: #1c2724;
    font-size: 0.95rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .hero-rail .rail-year {
    color: #8a938e;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .hero-body {
    padding: 1.1rem 1.4rem 1.2rem 1.2rem;
    min-width: 0;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.2rem;
    color: #8a938e;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .crumbs a {
    color: #2f6f5b;
    text-decoration: none;
  }

  .newer-note {
    margin: 0 0 0.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid #e2ddd0;
    border-radius: 0.55rem;
    background: #faf6ea;
    color: #6b5d33;
    font-size: 0.85rem;
  }

  .newer-note a {
    color: #2f6f5b;
    font-weight: 700;
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event h1 {
    margin: 0 0 0.55rem;
    font-size: clamp(1.55rem, 3.5vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }

  .badges .badge {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.22rem 0.6rem;
  }

  .badge.kind {
    background: #ece7f7;
    color: #46336b;
  }

  .badge.ultra {
    background: #fde8e8;
    color: #8a2f2f;
  }

  .badge:not(.kind):not(.unreviewed):not(.ultra) {
    background: #edf0eb;
    color: #3f4a45;
  }

  .badge.unreviewed {
    background: #f7e6c3;
    color: #7a4f16;
  }

  .hero-meta {
    margin: 0 0 0.9rem;
    color: #52605b;
    font-size: 0.95rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.4rem;
    padding: 0 1rem;
    border: 1px solid #d9ded8;
    border-radius: 0.6rem;
    background: #fff;
    color: #1c2724;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.12s ease, background 0.12s ease;
  }

  .btn:hover {
    border-color: #9db8ac;
    background: #f5f8f5;
  }

  .btn.primary {
    background: #2f6f5b;
    border-color: #2f6f5b;
    color: #fff;
  }

  .btn.primary:hover {
    background: #265a49;
    border-color: #265a49;
  }

  .btn:focus-visible,
  .sources a:focus-visible,
  .siblings a:focus-visible {
    outline: 2px solid #2f6f5b;
    outline-offset: 2px;
    border-radius: 4px;
  }

  section {
    margin-bottom: 1.9rem;
  }

  .section-title {
    margin: 0 0 0.7rem;
    color: #5b6660;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  /* Course cards replace the table */
  .about {
    margin: 0;
    max-width: 44rem;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .course-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-card {
    padding: 0.8rem 0.95rem;
    border: 1px solid #e7e3d6;
    border-radius: 0.8rem;
    background: #faf9f6;
  }

  .course-distance {
    margin: 0;
    color: #2f6f5b;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .course-name {
    margin: 0.1rem 0 0;
    color: #1c2724;
    font-size: 0.88rem;
    font-weight: 650;
  }

  .course-detail {
    margin: 0.25rem 0 0;
    color: #6b7673;
    font-size: 0.78rem;
  }

  .price-list {
    display: grid;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid #efede6;
    border-radius: 0.6rem;
    background: #fdfcfa;
  }

  .price-amount {
    color: #2f6f5b;
    font-size: 1rem;
    font-weight: 800;
  }

  .price-label {
    font-weight: 650;
    font-size: 0.9rem;
  }

  .price-note-inline {
    color: #8a938e;
    font-size: 0.8rem;
  }

  .price-freshness {
    margin: 0.6rem 0 0;
    color: #8a938e;
    font-size: 0.8rem;
  }

  .price-freshness a {
    color: #2f6f5b;
  }

  .price-note {
    margin: 0 0 0.4rem;
    color: #8a938e;
    font-size: 0.8rem;
  }

  .where {
    margin: 0;
    font-size: 1rem;
  }

  .note {
    margin: 0.25rem 0;
    color: #6b7673;
    font-size: 0.85rem;
  }

  .nearby-list {
    display: grid;
    gap: 0.4rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .nearby-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid #efede6;
    border-radius: 0.6rem;
    background: #fdfcfa;
  }

  .nearby-list a {
    color: #2f6f5b;
    font-weight: 700;
    text-decoration: none;
  }

  .nearby-list a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sources {
    display: grid;
    gap: 0.55rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .source-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid #efede6;
    border-radius: 0.6rem;
    background: #fdfcfa;
  }

  .sources a {
    color: #2f6f5b;
    font-weight: 700;
    text-decoration: none;
  }

  .sources a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .siblings {
    display: grid;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .siblings a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #2f6f5b;
    font-weight: 600;
    text-decoration: none;
  }

  .siblings a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .flag.small {
    font-size: 1rem;
  }

  @media (max-width: 40rem) {
    .event-hero {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }

    .hero-rail .flag {
      font-size: 1.7rem;
    }
  }
</style>
