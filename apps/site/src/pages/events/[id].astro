---
import { editions, slugForEvent } from "../../lib/catalog";

// Legacy URLs (/events/<full-id-with-source-and-year>) redirect to the
// canonical /events/<slug>/<year> pages. Static hosting: meta refresh.
export function getStaticPaths() {
  return editions.map((edition) => ({
    params: { id: edition.id },
    props: {
      target: `/events/${slugForEvent(edition.event_id)}/${edition.edition}`,
    },
  }));
}

interface Props {
  target: string;
}

const { target } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>
      This page moved to <a href={target}>{target}</a>.
    </p>
  </body>
</html>
