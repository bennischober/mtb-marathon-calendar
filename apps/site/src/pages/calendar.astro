---
import Base from "../layouts/Base.astro";
import PinButton from "../components/PinButton.astro";
import {
  calendarCells,
  calendarMonths,
  editionDayNumber,
  editionTotalDays,
  editionUrl,
} from "../lib/catalog";
import {
  formatDateRange,
  formatDateShort,
  formatDistance,
  formatKind,
} from "../lib/format";

const groups = calendarMonths();
const weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const weekdayOf = (iso: string): number =>
  (new Date(`${iso}T00:00:00Z`).getUTCDay() + 6) % 7;
const isWeekend = (iso: string): boolean => weekdayOf(iso) >= 5;
---

<Base
  title="Calendar — MTB Marathon Calendar"
  description="Every mountain bike marathon and stage race laid out month by month."
>
  <div class="cal-toolbar">
    <div class="cal-nav" role="group" aria-label="Change month">
      <button type="button" id="cal-prev" class="pager-btn" aria-label="Previous month" title="Previous month (←)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <label class="pager-month">
        <span class="sr-only">Jump to month</span>
        <select id="cal-select" aria-label="Jump to month">
          {
            groups.map((group) => (
              <option value={group.key}>{group.label}</option>
            ))
          }
        </select>
      </label>
      <button type="button" id="cal-next" class="pager-btn" aria-label="Next month" title="Next month (→)">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" id="cal-today" class="pager-btn pager-btn-text" hidden>Today</button>
    </div>
    <p class="pager-count" id="cal-count" role="status" aria-live="polite"></p>
    <p class="legend" aria-label="Calendar legend">
      <span class="legend-item"><span class="dot dot-start" /> starts</span>
      <span class="legend-item"><span class="dot dot-cont" /> continues</span>
      <span class="legend-item"><span class="swatch swatch-weekend" /> weekend</span>
      <span class="legend-item"><span class="swatch swatch-today" /> today</span>
    </p>
  </div>

  {
    groups.map((group) => (
      <section class="month" id={`month-${group.key}`} data-month={group.key}>
        <div class="month-head">
          <h2 tabindex="-1">{group.label}</h2>
          <p class="month-sub">
            {group.editions.length}{" "}
            {group.editions.length === 1 ? "race" : "races"}
          </p>
        </div>

        <div class="grid" role="table" aria-label={`Races in ${group.label}`}>
          {weekdays.map((day) => (
            <div class="cell weekday" role="columnheader">
              {day}
            </div>
          ))}

          {calendarCells(group.key).map((cell) => (
            <div
              class:list={[
                "cell",
                { empty: !cell.editions.length, muted: !cell.inMonth },
                { weekend: isWeekend(cell.iso) && cell.inMonth },
              ]}
              role="cell"
              data-iso={cell.iso}
            >
              <span class="day">{cell.day}</span>
              <ul>
                {cell.editions.map((edition) => {
                  const start = edition.date_start === cell.iso;
                  const total = editionTotalDays(edition);
                  const dayNo = editionDayNumber(edition, cell.iso);
                  return (
                    <li
                      class:list={[{ continued: !start }]}
                      data-format={edition.format}
                      data-id={edition.id}
                    >
                      <a
                        href={editionUrl(edition)}
                        title={`${edition.name} · ${formatDateRange(edition.date_start, (edition as { date_end?: string | null }).date_end ?? undefined)}`}
                      >
                        {!start && total > 1 ? `↳ ${edition.name}` : edition.name}
                      </a>
                      <PinButton editionId={edition.id} name={edition.name} compact />
                      <span class="cell-meta">
                        {!start && total > 1
                          ? `Day ${dayNo}/${total} · ${formatKind(edition.format)}`
                          : `${formatKind(edition.format)} · ${edition.location.country}`}
                        {start &&
                          edition.course_variants.length > 0 &&
                          ` · ${formatDistance(
                            Math.max(
                              ...edition.course_variants.map(
                                (course) => course.distance_km,
                              ),
                            ),
                          )}`}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>

        <details class="month-list">
          <summary>
            All {group.editions.length}{" "}
            {group.editions.length === 1 ? "race" : "races"} in {group.label}
          </summary>
          <ul>
            {[...group.editions]
              .sort((a, b) => a.date_start.localeCompare(b.date_start))
              .map((edition) => (
                <li>
                  <a href={editionUrl(edition)}>{edition.name}</a>
                  <span>
                    {" "}
                    ·{" "}
                    {formatDateRange(
                      edition.date_start,
                      (edition as { date_end?: string | null }).date_end ??
                        undefined,
                    )}{" "}
                    · {edition.location.name}, {edition.location.country} ·{" "}
                    {formatKind(edition.format)}
                    {(edition as { date_end?: string | null }).date_end &&
                    (edition as { date_end?: string | null }).date_end !==
                      edition.date_start
                      ? ` · ${formatDateShort(edition.date_start)} → ${formatDateShort((edition as { date_end?: string }).date_end)}`
                      : ""}
                  </span>
                </li>
              ))}
          </ul>
        </details>
      </section>
    ))
  }
</Base>

<script>
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(".month[data-month]"),
  );
  const keys = sections.map((s) => s.dataset.month ?? "").filter(Boolean);
  const prev = document.querySelector<HTMLButtonElement>("#cal-prev");
  const next = document.querySelector<HTMLButtonElement>("#cal-next");
  const select = document.querySelector<HTMLSelectElement>("#cal-select");
  const count = document.querySelector<HTMLElement>("#cal-count");
  const todayButton = document.querySelector<HTMLButtonElement>("#cal-today");

  function keyFromHash(): string | null {
    const hash = window.location.hash.replace(/^#/, "");
    return keys.includes(hash) ? hash : null;
  }

  function fallbackKey(): string {
    const todayMonth = new Date().toISOString().slice(0, 7);
    if (keys.includes(todayMonth)) return todayMonth;
    const today = new Date().toISOString().slice(0, 10);
    const upcoming = keys.filter((k) => `${k}-01` >= today.slice(0, 7) + "-01");
    return upcoming[0] ?? keys[0] ?? "";
  }

  function show(key: string, moveFocus = false): void {
    if (!keys.includes(key)) return;
    for (const section of sections) {
      section.hidden = section.dataset.month !== key;
    }
    const index = keys.indexOf(key);
    if (prev) prev.disabled = index <= 0;
    if (next) next.disabled = index >= keys.length - 1;
    if (select && select.value !== key) select.value = key;
    if (todayButton) {
      todayButton.hidden = key === new Date().toISOString().slice(0, 7);
    }
    if (count) {
      const section = sections[index];
      const races = section?.querySelectorAll(".cell li").length ?? 0;
      const label = select?.selectedOptions[0]?.textContent ?? key;
      count.textContent = `${label} · ${races} ${races === 1 ? "race day" : "race days"}`;
    }
    if (window.location.hash !== `#${key}`) {
      history.replaceState(null, "", `#${key}`);
    }
    if (moveFocus) {
      sections[index]?.querySelector("h2")?.focus({ preventScroll: true });
      sections[index]?.scrollIntoView({ block: "start" });
    }
  }

  function step(delta: -1 | 1, moveFocus = false): void {
    const current = keyFromHash() ?? select?.value ?? keys[0] ?? "";
    const nextKey = keys[keys.indexOf(current) + delta];
    if (nextKey) show(nextKey, moveFocus);
  }

  prev?.addEventListener("click", () => step(-1, true));
  next?.addEventListener("click", () => step(1, true));
  todayButton?.addEventListener("click", () => {
    if (todayButton.dataset.month) show(todayButton.dataset.month, true);
  });
  {
    const currentMonth = new Date().toISOString().slice(0, 7);
    if (todayButton) todayButton.dataset.month = currentMonth;
  }
  select?.addEventListener("change", () => {
    if (select.value) show(select.value);
  });
  window.addEventListener("hashchange", () => {
    const key = keyFromHash();
    if (key) show(key);
  });
  window.addEventListener("keydown", (event) => {
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    const target = event.target as HTMLElement | null;
    if (
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "SELECT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable)
    ) {
      return;
    }
    event.preventDefault();
    step(event.key === "ArrowLeft" ? -1 : 1, true);
  });

  // Highlight today without baking a build date into the static HTML.
  const todayIso = new Date().toISOString().slice(0, 10);
  document
    .querySelector(`[data-iso="${todayIso}"]`)
    ?.classList.add("today");

  document.querySelectorAll<HTMLButtonElement>("button[data-pin]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const id = button.dataset.pin ?? "";
      const pins = JSON.parse(localStorage.getItem("mtb-pinned-editions") ?? "[]") as string[];
      const next = pins.includes(id) ? pins.filter((pin) => pin !== id) : [...pins, id];
      localStorage.setItem("mtb-pinned-editions", JSON.stringify(next));
      window.dispatchEvent(new CustomEvent("mtb:pins-changed"));
    });
  });
  window.addEventListener("mtb:pins-changed", refreshPinnedCells);
  refreshPinnedCells();

  function refreshPinnedCells(): void {
    const pins = new Set(
      JSON.parse(localStorage.getItem("mtb-pinned-editions") ?? "[]") as string[],
    );
    for (const entry of document.querySelectorAll<HTMLElement>(".cell li[data-id]")) {
      entry.classList.toggle("pinned", pins.has(entry.dataset.id ?? ""));
    }
  }

  show(keyFromHash() ?? fallbackKey());
</script>

<style>
  .cal-toolbar {
    position: sticky;
    top: 3.5rem; /* directly under the 56px app header */
    z-index: 15;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin: 0 -1rem 0.75rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--hairline-soft);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
  }

  @media (max-width: 40rem) {
    .cal-toolbar {
      margin: 0 -0.5rem 0.75rem;
      padding: 0.5rem 0.5rem;
    }
  }

  .cal-nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .pager-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid transparent;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
  }

  .pager-btn:hover:not(:disabled) {
    background: #f0eee7;
    border-color: #e2ddd0;
  }

  .pager-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .pager-btn-text {
    width: auto;
    padding: 0 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .pager-month select {
    padding: 0.25rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    cursor: pointer;
  }

  .pager-month select:hover {
    background: var(--bg-tint);
  }

  .pager-month select:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .pager-count {
    margin: 0;
    color: var(--text-mute);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0 0 0 auto;
    color: var(--text-mute);
    font-size: 0.78rem;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dot,
  .swatch {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
  }

  .dot-start {
    background: var(--accent-bar);
  }

  .dot-cont {
    background: transparent;
    border: 2px solid #b3a284;
    border-radius: 2px;
    width: 0.55rem;
    height: 0.55rem;
  }

  .swatch-weekend {
    background: #f3efe4;
    border: 1px solid var(--hairline);
    border-radius: 0.2rem;
  }

  .swatch-today {
    background: var(--accent-tint);
    border: 1px solid var(--focus-ring);
    border-radius: 0.2rem;
  }

  .month {
    margin-bottom: 2.5rem;
    scroll-margin-top: 7.5rem;
  }

  .month[hidden] {
    display: none;
  }

  .month-head {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .month-head h2:focus-visible {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .month-sub {
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1rem;
    background: #e7e5e0;
  }

  .cell {
    min-height: 8.5rem;
    padding: 0.55rem 0.6rem;
    background: var(--surface)
  }

  .cell.weekday {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    background: var(--bg-tint);
    color: var(--text-soft);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cell.muted {
    background: var(--bg-soft);
  }

  .cell.empty {
    background: var(--bg-tint);
  }

  .cell.weekend {
    background: var(--bg-tint);
  }

  .cell.weekend.muted {
    background: var(--bg-soft);
  }

  .cell.today {
    box-shadow: inset 0 0 0 2px var(--focus-ring);
    background: #f0f6f1;
  }

  .cell:hover {
    background: var(--bg-tint);
  }

  .day {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--text-mute);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .cell.muted .day {
    color: #b3bab4;
  }

  .cell.today .day {
    color: var(--accent);
  }

  .cell ul {
    display: grid;
    gap: 0.28rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each race entry is a small chip: format-colored left border makes the
     event type scannable across the whole grid. */
  .cell li {
    --chip: var(--fmt-single);
    position: relative;
    padding: 0.25rem 0.3rem 0.3rem 0.5rem;
    border-left: 3px solid var(--chip);
    border-radius: 0.3rem;
    background: var(--bg-tint);
  }

  .cell li[data-format="stage_race"] {
    --chip: var(--fmt-stage);
  }

  .cell li[data-format="point_to_point"] {
    --chip: var(--fmt-p2p);
  }

  .cell li[data-format="multi_day"] {
    --chip: var(--fmt-multi);
  }

  .cell li.continued {
    --chip: var(--fmt-cont);
    opacity: 0.95;
  }

  .cell li.pinned {
    outline: 1.5px solid #d9b96a;
    background: #fdf8e8;
  }

  .pin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.15rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface)
    color: var(--text-mute);
    cursor: pointer;
  }

  .pin-btn:hover {
    color: var(--accent);
  }

  .pin-btn[aria-pressed="true"] {
    color: var(--pin);
    border-color: var(--pin-border);
    background: var(--pin-bg);
  }



  .cell a {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .cell a:hover {
    text-decoration: underline;
  }

  .cell li.continued a {
    font-weight: 500;
    color: var(--text-soft);
  }

  .cell-meta {
    display: block;
    color: var(--text-mute);
    font-size: 0.68rem;
  }

  .month-list {
    margin-top: 0.75rem;
    border: 1px solid #e7e5e4;
    border-radius: 0.75rem;
    background: var(--surface)
    padding: 0.6rem 0.9rem;
  }

  .month-list summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent-ink);
  }

  .month-list ul {
    margin: 0.5rem 0 0.25rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
  }

  .month-list li span {
    color: var(--text-mute);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 45rem) {
    .cal-toolbar {
      gap: 0.4rem 0.75rem;
    }

    .legend {
      order: 3;
      flex-basis: 100%;
      margin: 0;
    }

    .pager-month select {
      font-size: 1.05rem;
    }

    .grid {
      display: block;
      background: transparent;
      border: 0;
      overflow: visible;
    }

    .cell.weekday {
      display: none;
    }

    .cell {
      display: grid;
      grid-template-columns: 3.4rem minmax(0, 1fr);
      min-height: 0;
      margin-bottom: 0.5rem;
      padding: 0;
      border: 1px solid var(--hairline);
      border-radius: 0.8rem;
      background: var(--surface)
      overflow: hidden;
    }

    .cell.empty {
      display: none;
    }

    .cell.muted {
      display: none;
    }

    .cell .day {
      grid-column: 1;
      grid-row: 1 / span 2;
      align-self: start;
      margin: 0;
      padding: 0.7rem 0;
      border-right: 1px solid var(--hairline-soft);
      background: var(--bg-soft);
      color: var(--text);
      font-size: 0.95rem;
      font-weight: 800;
      text-align: center;
    }

    .cell.weekend .day {
      background: var(--bg-tint);
    }

    .cell .day::after {
      content: "";
      display: block;
      margin-top: 0.15rem;
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--text-mute);
    }

    .cell ul {
      grid-column: 2;
      padding: 0.55rem 0.7rem 0.6rem;
    }

    .cell ul:empty {
      padding: 0;
    }

    .pin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.15rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface)
    color: var(--text-mute);
    cursor: pointer;
  }

  .pin-btn:hover {
    color: var(--accent);
  }

  .pin-btn[aria-pressed="true"] {
    color: var(--pin);
    border-color: var(--pin-border);
    background: var(--pin-bg);
  }

  .cell li.continued {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
