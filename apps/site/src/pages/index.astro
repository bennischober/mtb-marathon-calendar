---
import Base from "../layouts/Base.astro";
import {
  buildDate,
  classifications,
  countries,
  editions,
  editionTotalDays,
  futureEditions,
  generatedAt,
  kinds,
  monthGroups,
  searchHaystack,
} from "../lib/catalog";
import { formatCourseLabel, formatDateRange, formatDistance, formatKind, formatTimestamp } from "../lib/format";

const months = monthGroups();
const visible = futureEditions;
---

<Base
  title="All races — MTB Marathon Calendar"
  description="Every mountain bike marathon, ultra and stage race we have collected, filterable by country, format and month."
>
  <section class="toolbar" aria-labelledby="filters-heading">
    <h2 id="filters-heading" class="sr-only">Filter races</h2>

    <div class="toolbar-row">
      <label class="search">
        <span class="sr-only">Search</span>
        <input
          type="search"
          id="search"
          placeholder="Search races…  (press /)"
          autocomplete="off"
        />
      </label>

      <button type="button" id="filters-toggle" aria-expanded="false" aria-controls="filter-panel">
        Filters <span class="filter-badge" id="filter-badge" hidden>0</span>
      </button>

      <label class="select">
        <span class="sr-only">Sort</span>
        <select id="sort" aria-label="Sort races">
          <option value="date">Soonest first</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>
    </div>

    <div class="filter-panel" id="filter-panel" hidden>
      <fieldset>
        <legend class="filter-label">When</legend>
        <div class="chips" role="radiogroup" aria-label="When">
          <label class="chip option">
            <input type="radio" name="when" value="upcoming" checked />
            <span>Upcoming</span>
          </label>
          <label class="chip option">
            <input type="radio" name="when" value="past" />
            <span>Past</span>
          </label>
          <label class="chip option">
            <input type="radio" name="when" value="all" />
            <span>All time</span>
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Class</legend>
        <div class="chips">
          {
            classifications.map((kind) => (
              <label class="chip option">
                <input type="checkbox" name="class" value={kind.value} />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Format</legend>
        <div class="chips">
          {
            kinds.map((kind) => (
              <label class="chip option">
                <input type="checkbox" name="format" value={kind.value} />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Country</legend>
        <div class="chips">
          {
            countries.map((code) => (
              <label class="chip option">
                <input type="checkbox" name="country" value={code} />
                <span>{code}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Month</legend>
        <label class="select">
          <span class="sr-only">Month</span>
          <select id="month">
            <option value="">All months</option>
            {months.map((group) => <option value={group.key}>{group.label}</option>)}
          </select>
        </label>
      </fieldset>

      <div class="panel-foot">
        <button type="button" id="clear-filters">Clear all</button>
      </div>
    </div>

    <div class="applied" id="applied-filters" hidden>
      <span class="applied-label">Filters:</span>
      <span id="applied-list" />
      <button type="button" id="clear-inline">Clear</button>
    </div>
  </section>

  <p class="result-count" id="result-count" role="status" aria-live="polite">
    {visible.length} races
  </p>

  <ul class="event-list" id="event-list">
    {
      editions.map((edition) => {
        const end = (edition as { date_end?: string | null }).date_end ?? edition.date_start;
        const days = editionTotalDays(edition);
        return (
          <li
            class="event-card"
            data-country={edition.location.country}
            data-format={edition.format}
            data-class={edition.classification}
            data-month={edition.date_start.slice(0, 7)}
            data-review={edition.review.status}
            data-search={searchHaystack(edition)}
            data-name={edition.name.toLowerCase()}
            data-date={edition.date_start}
            data-end={end}
          >
            <div class="event-heading">
              <div class="min-w-0">
                <p class="event-date">
                  {formatDateRange(edition.date_start, (edition as { date_end?: string | null }).date_end ?? undefined)}
                  {days > 1 && <span class="days-pill">{days} days</span>}
                </p>
                <h2>
                  <a href={`/events/${edition.id}`}>{edition.name}</a>
                </h2>
              </div>
              <div class="badges">
                <span class="badge kind">{formatKind(edition.format)}</span>
                {edition.classification === "mtb_ultra" && (
                  <span class="badge ultra">Ultra</span>
                )}
                <span class="badge">{edition.location.country}</span>
                {edition.review.status !== "approved" && (
                  <span class="badge unreviewed">{edition.review.status}</span>
                )}
              </div>
            </div>

            <p class="event-meta">
              {edition.location.name}
              {edition.location.region ? `, ${edition.location.region}` : ""}
              {" · "}
              <a href={edition.official_url} target="_blank" rel="noopener noreferrer">Official page ↗</a>
            </p>

            {edition.course_variants.length > 0 && (
              <ul class="course-list">
                {edition.course_variants.map((course) => (
                  <li>
                    {formatCourseLabel(course.name, course.distance_km)}
                  </li>
                ))}
              </ul>
            )}

            <p class="card-foot">
              <a href={`/events/${edition.id}`} aria-label={`Details for ${edition.name}`}>
                View details →
              </a>
            </p>
          </li>
        );
      })
    }
  </ul>

  <p class="empty" id="no-results" hidden>
    No races match those filters. <button type="button" id="reset-2">Clear them</button>
  </p>

  <p class="generated">Data collected {formatTimestamp(generatedAt)}.</p>
</Base>

<script>
  const list = document.querySelector<HTMLUListElement>("#event-list");
  const cards = Array.from(list?.querySelectorAll<HTMLElement>(".event-card") ?? []);
  const search = document.querySelector<HTMLInputElement>("#search");
  const month = document.querySelector<HTMLSelectElement>("#month");
  const sort = document.querySelector<HTMLSelectElement>("#sort");
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#no-results");
  const panel = document.querySelector<HTMLElement>("#filter-panel");
  const toggle = document.querySelector<HTMLButtonElement>("#filters-toggle");
  const badge = document.querySelector<HTMLElement>("#filter-badge");
  const appliedBox = document.querySelector<HTMLElement>("#applied-filters");
  const appliedList = document.querySelector<HTMLElement>("#applied-list");

  const today = new Date().toISOString().slice(0, 10);
  const isPast = (card: HTMLElement): boolean => (card.dataset.end ?? "") < today;

  const checked = (name: string): string[] =>
    Array.from(
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`),
    ).map((input) => input.value);

  // Filter semantics: nothing checked in a group = that group is inactive
  // (show everything). Checking values restricts to them. This matches how
  // modern faceted search works: filters are opt-in restrictions.
  function apply(): void {
    const countriesWanted = checked("country");
    const formatsWanted = checked("format");
    const classesWanted = checked("class");
    const when = (
      document.querySelector<HTMLInputElement>('input[name="when"]:checked')?.value ?? "upcoming"
    );
    const monthWanted = month?.value ?? "";
    const query = (search?.value ?? "").trim().toLowerCase();

    let shown = 0;
    let anyFilterActive = false;
    for (const card of cards) {
      const matches =
        (countriesWanted.length === 0 || countriesWanted.includes(card.dataset.country ?? "")) &&
        (formatsWanted.length === 0 || formatsWanted.includes(card.dataset.format ?? "")) &&
        (classesWanted.length === 0 || classesWanted.includes(card.dataset.class ?? "")) &&
        (!monthWanted || card.dataset.month === monthWanted) &&
        (!query || (card.dataset.search ?? "").includes(query)) &&
        (when === "all" ||
          (when === "past" ? isPast(card) : !isPast(card)));
      card.hidden = !matches;
      if (matches) shown += 1;
    }

    anyFilterActive =
      query !== "" ||
      monthWanted !== "" ||
      countriesWanted.length > 0 ||
      formatsWanted.length > 0 ||
      classesWanted.length > 0 ||
      when !== "upcoming";

    if (count) {
      count.textContent = `${shown} of ${cards.length} races`;
    }
    if (empty) empty.hidden = shown > 0;
    if (badge) {
      badge.hidden = !anyFilterActive;
      badge.textContent = String(
        (query ? 1 : 0) +
          (monthWanted ? 1 : 0) +
          (countriesWanted.length ? 1 : 0) +
          (formatsWanted.length ? 1 : 0) +
          (classesWanted.length ? 1 : 0) +
          (when !== "upcoming" ? 1 : 0),
      );
    }
    renderApplied();
  }

  function renderApplied(): void {
    if (!appliedBox || !appliedList) return;
    const lozenges: string[] = [];
    const query = (search?.value ?? "").trim();
    if (query) lozenges.push(`“${query}”`);
    const when = document.querySelector<HTMLInputElement>('input[name="when"]:checked')?.value;
    if (when && when !== "upcoming") {
      lozenges.push(when === "past" ? "Past" : "All time");
    }
    for (const name of ["class", "format", "country"]) {
      for (const value of checked(name)) {
        const label =
          document.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`)
            ?.closest("label")
            ?.querySelector("span")
            ?.textContent ?? value;
        lozenges.push(label);
      }
    }
    const monthWanted = month?.value;
    if (monthWanted) {
      const label = month.selectedOptions[0]?.textContent ?? monthWanted;
      lozenges.push(label);
    }
    appliedBox.hidden = lozenges.length === 0;
    appliedList.replaceChildren(
      ...lozenges.map((text) => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "lozenge";
        chip.textContent = text;
        return chip;
      }),
    );
  }

  // Lozenges remove one filter each.
  appliedList?.addEventListener("click", (event) => {
    const chip = (event.target as HTMLElement).closest("button.lozenge");
    if (!chip) return;
    const text = chip.textContent ?? "";
    const searchInput = search;
    if (searchInput && text.startsWith("“")) {
      searchInput.value = "";
    } else if (text === "Past" || text === "All time") {
      const radio = document.querySelector<HTMLInputElement>('input[name="when"][value="upcoming"]');
      if (radio) radio.checked = true;
    } else if (text === month?.selectedOptions[0]?.textContent) {
      month.value = "";
    } else {
      const checkbox = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
      ).find((input) => input.closest("label")?.querySelector("span")?.textContent === text);
      if (checkbox) checkbox.checked = false;
    }
    apply();
  });

  function clearAll(): void {
    if (search) search.value = "";
    if (month) month.value = "";
    for (const input of document.querySelectorAll<HTMLInputElement>(
      'input[name="class"], input[name="format"], input[name="country"]',
    )) {
      input.checked = false;
    }
    const upcoming = document.querySelector<HTMLInputElement>('input[name="when"][value="upcoming"]');
    if (upcoming) upcoming.checked = true;
    apply();
  }

  toggle?.addEventListener("click", () => {
    const open = panel?.hidden ?? false;
    if (panel) panel.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
  });

  search?.addEventListener("input", apply);
  month?.addEventListener("change", apply);
  sort?.addEventListener("change", sortCards);
  document
    .querySelectorAll<HTMLInputElement>('input[name="class"], input[name="format"], input[name="country"], input[name="when"]')
    .forEach((input) => input.addEventListener("change", apply));
  document.querySelector("#clear-filters")?.addEventListener("click", clearAll);
  document.querySelector("#clear-inline")?.addEventListener("click", clearAll);
  document.querySelector("#reset-2")?.addEventListener("click", clearAll);

  function sortCards(): void {
    if (!list) return;
    const mode = sort?.value ?? "date";
    const visible = cards.filter((card) => !card.hidden);
    const hidden = cards.filter((card) => card.hidden);
    const ordered = [...visible].sort((a, b) =>
      mode === "name"
        ? (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
        : (a.dataset.date ?? "").localeCompare(b.dataset.date ?? ""),
    );
    for (const card of [...ordered, ...hidden]) list.appendChild(card);
  }

  window.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "SELECT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable);
    if (event.key === "/" && !typing) {
      event.preventDefault();
      search?.focus();
    } else if (event.key === "Escape" && document.activeElement === search) {
      if (search.value) {
        search.value = "";
        apply();
      } else {
        search.blur();
      }
    }
  });

  apply();
</script>

<style>
  /* Toolbar: one quiet row — search, Filters button, sort. The panel opens
     on demand; applied filters show as removable lozenges. */

  .toolbar {
    margin-bottom: 0.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid #e5e2da;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1px 2px rgb(28 39 36 / 0.04);
  }

  .toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .search {
    flex: 1 1 260px;
    min-width: min(260px, 100%);
  }

  .search input {
    width: 100%;
    height: 2.6rem;
    padding: 0 0.8rem;
    border: 1px solid #d9ded8;
    border-radius: 0.7rem;
    background: #fff;
    font: inherit;
    font-size: 0.95rem;
  }

  .search input:focus {
    outline: 2px solid #2f6f5b;
    outline-offset: 1px;
    border-color: #2f6f5b;
    box-shadow: 0 0 0 4px rgb(47 111 91 / 0.1);
  }

  #filters-toggle,
  #clear-filters,
  #clear-inline,
  #reset-2 {
    height: 2.6rem;
    padding: 0 1.1rem;
    border: 1px solid #d9ded8;
    border-radius: 0.7rem;
    background: #fff;
    color: #1c2724;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  #filters-toggle {
    background: #f5f4f0;
  }

  #filters-toggle:hover,
  #clear-filters:hover,
  #clear-inline:hover,
  #reset-2:hover {
    border-color: #9db8ac;
    background: #f0f4f0;
  }

  #filters-toggle[aria-expanded="true"] {
    background: #1c2724;
    border-color: #1c2724;
    color: #fff;
  }

  .filter-badge {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: #2f6f5b;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .select select {
    height: 2.6rem;
    padding: 0 0.7rem;
    border: 1px solid #d9ded8;
    border-radius: 0.7rem;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .select select:focus {
    outline: 2px solid #2f6f5b;
    outline-offset: 1px;
  }

  .filter-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem 1.5rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid #efede6;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .filter-label {
    display: block;
    margin-bottom: 0.4rem;
    color: #5b6660;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.8rem;
    border: 1px solid #d9ded8;
    border-radius: 999px;
    background: #fff;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
  }

  .chip:hover {
    border-color: #9db8ac;
  }

  .chip:focus-within {
    outline: 2px solid #2f6f5b;
    outline-offset: 2px;
  }

  .chip:has(input:checked) {
    border-color: #2f6f5b;
    background: #e2efe8;
    color: #24493c;
    font-weight: 700;
  }

  .chip input {
    margin: 0;
    accent-color: #2f6f5b;
  }

  .panel-foot {
    display: flex;
    align-items: end;
  }

  .applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #efede6;
  }

  #applied-list {
    display: contents;
  }

  .applied-label {
    color: #6b7673;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .lozenge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.7rem;
    border: 1px solid #2f6f5b;
    border-radius: 999px;
    background: #e2efe8;
    color: #24493c;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .lozenge::after {
    content: "✕";
    margin-left: 0.45rem;
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .lozenge:hover::after {
    opacity: 1;
  }

  .result-count {
    margin: 0 0 0.9rem;
    color: #52605b;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .event-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 62rem) {
    .event-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .event-list .event-card {
    --accent: #2f6f5b;
    position: relative;
    overflow: hidden;
    padding: 1.3rem 1.4rem 1.15rem 1.6rem;
    border: 1px solid #e5e2da;
    border-radius: 1.15rem;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(28 39 36 / 0.05),
      0 10px 28px -18px rgb(28 39 36 / 0.3);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .event-list .event-card::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 5px;
    background: var(--accent);
  }

  .event-list .event-card[data-format="stage_race"] {
    --accent: #6d4fc2;
  }

  .event-list .event-card[data-format="point_to_point"] {
    --accent: #2563eb;
  }

  .event-list .event-card[data-format="multi_day"] {
    --accent: #b45309;
  }

  .event-list .event-card:hover {
    transform: translateY(-3px);
    border-color: #cfcaba;
    box-shadow:
      0 2px 4px rgb(28 39 36 / 0.06),
      0 18px 40px -20px rgb(28 39 36 / 0.35);
  }

  .event-list .event-card:hover .event-heading h2 a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .event-card[hidden] {
    display: none;
  }

  .event-list .event-date {
    color: #2f6f5b;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-list .days-pill {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.12rem 0.6rem;
    border-radius: 999px;
    background: #e2efe8;
    color: #24493c;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: none;
    vertical-align: 1px;
  }

  .event-list .event-heading h2 {
    margin: 0.35rem 0 0;
    font-size: 1.3rem;
    font-weight: 750;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .event-list .event-heading h2 a {
    color: #1c2724;
    text-decoration: none;
  }

  .event-list .badges .badge {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.24rem 0.65rem;
  }

  .event-list .badges .badge.kind {
    background: #ece7f7;
    color: #46336b;
  }

  .event-list .badges .badge.ultra {
    background: #fde8e8;
    color: #8a2f2f;
  }

  .event-list .badges .badge:not(.kind):not(.unreviewed):not(.ultra) {
    background: #edf0eb;
    color: #3f4a45;
  }

  .event-list .badges .badge.unreviewed {
    background: #f7e6c3;
    color: #7a4f16;
  }

  .event-list .event-meta {
    margin: 0.55rem 0 0;
    color: #52605b;
    font-size: 0.93rem;
  }

  .event-list .course-list li {
    border: 1px solid #e7e3d6;
    background: #f4f2ea;
    font-weight: 500;
  }

  .event-list .card-foot {
    margin: 0.85rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid #efe9db;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .event-list .card-foot a {
    color: #2f6f5b;
    text-decoration: none;
  }

  .event-list .card-foot a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .empty {
    padding: 2.5rem 2rem;
    background: #fff;
  }

  .empty button {
    padding: 0.35rem 0.9rem;
    border: 1px solid #2f6f5b;
    border-radius: 999px;
    background: #2f6f5b;
    color: #fffefa;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .generated {
    margin-top: 1.5rem;
    color: #8a938e;
    font-size: 0.85rem;
  }

