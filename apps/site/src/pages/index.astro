---
import Base from "../layouts/Base.astro";
import {
  countries,
  editions,
  editionTotalDays,
  generatedAt,
  kinds,
  monthGroups,
  searchHaystack,
} from "../lib/catalog";
import { formatDateRange, formatDistance, formatKind, formatTimestamp } from "../lib/format";

const months = monthGroups();
---

<Base
  title="All races — MTB Marathon Calendar"
  description="Every mountain bike marathon, ultra and stage race we have collected, filterable by country, format and month."
>
  <section
    class="filters sticky top-0 z-10 rounded-2xl border border-stone-200 bg-white/95 px-4 py-4 shadow-sm backdrop-blur"
    aria-labelledby="filters-heading"
  >
    <h2 id="filters-heading" class="sr-only">Filter races</h2>

    <div class="filter-row">
      <label class="search">
        <span class="filter-label">Search <kbd title="Press / to focus">/</kbd></span>
        <input
          type="search"
          id="search"
          placeholder="Race name or place"
          autocomplete="off"
        />
      </label>

      <fieldset>
        <legend class="filter-label">Country</legend>
        <div class="chips">
          {
            countries.map((code) => (
              <label class="chip">
                <input type="checkbox" name="country" value={code} checked />
                <span>{code}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Format</legend>
        <div class="chips">
          {
            kinds.map((kind) => (
              <label class="chip">
                <input type="checkbox" name="format" value={kind.value} checked />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Review</legend>
        <div class="chips">
          <label class="chip">
            <input type="checkbox" name="review" value="unreviewed" checked />
            <span>Unreviewed</span>
          </label>
          <label class="chip">
            <input type="checkbox" name="review" value="approved" checked />
            <span>Approved</span>
          </label>
        </div>
      </fieldset>

      <label class="month">
        <span class="filter-label">Month</span>
        <select id="month">
          <option value="">All months</option>
          {months.map((group) => <option value={group.key}>{group.label}</option>)}
        </select>
      </label>

      <label class="sort">
        <span class="filter-label">Sort</span>
        <select id="sort">
          <option value="date">Soonest first</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>

      <button type="button" id="reset">Reset</button>
    </div>

    <p class="result-count" id="result-count" role="status" aria-live="polite">
      Showing {editions.length} of {editions.length} races
    </p>
  </section>

  <ul class="event-list" id="event-list">
    {
      editions.map((edition) => {
        const end = (edition as { date_end?: string | null }).date_end ?? undefined;
        const days = editionTotalDays(edition);
        return (
          <li
            class="event-card group rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            data-country={edition.location.country}
            data-format={edition.format}
            data-month={edition.date_start.slice(0, 7)}
            data-review={edition.review.status}
            data-search={searchHaystack(edition)}
            data-name={edition.name.toLowerCase()}
            data-date={edition.date_start}
          >
            <div class="event-heading">
              <div class="min-w-0">
                <p class="event-date">
                  {formatDateRange(edition.date_start, end)}
                  {days > 1 ? ` · ${days} days` : ""}
                </p>
                <h2>
                  <a href={`/events/${edition.id}`}>{edition.name}</a>
                </h2>
              </div>
              <div class="badges">
                <span class="badge kind">{formatKind(edition.format)}</span>
                <span class="badge">{edition.location.country}</span>
                {edition.review.status !== "approved" && (
                  <span class="badge unreviewed">{edition.review.status}</span>
                )}
              </div>
            </div>

            <p class="event-meta">
              {edition.location.name}
              {edition.location.region ? `, ${edition.location.region}` : ""}
              {" · "}
              <a href={edition.official_url}>Official page ↗</a>
            </p>

            {edition.course_variants.length > 0 && (
              <ul class="course-list">
                {edition.course_variants.map((course) => (
                  <li>
                    {course.name}: {formatDistance(course.distance_km)}
                  </li>
                ))}
              </ul>
            )}

            <p class="card-foot">
              <a href={`/events/${edition.id}`} aria-label={`Details for ${edition.name}`}>
                View details →
              </a>
            </p>
          </li>
        );
      })
    }
  </ul>

  <p class="empty" id="no-results" hidden>
    No races match those filters. <button type="button" id="reset-2">Reset them</button>
  </p>

  <p class="generated">Data collected {formatTimestamp(generatedAt)}.</p>
</Base>

<script>
  const list = document.querySelector<HTMLUListElement>("#event-list");
  const cards = Array.from(list?.querySelectorAll<HTMLElement>(".event-card") ?? []);
  const search = document.querySelector<HTMLInputElement>("#search");
  const month = document.querySelector<HTMLSelectElement>("#month");
  const sort = document.querySelector<HTMLSelectElement>("#sort");
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#no-results");

  const checked = (name: string): string[] =>
    Array.from(
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`),
    ).map((input) => input.value);

  function apply(): void {
    const countriesWanted = checked("country");
    const formatsWanted = checked("format");
    const reviewsWanted = checked("review");
    const monthWanted = month?.value ?? "";
    const query = (search?.value ?? "").trim().toLowerCase();

    let shown = 0;
    for (const card of cards) {
      const matches =
        countriesWanted.includes(card.dataset.country ?? "") &&
        formatsWanted.includes(card.dataset.format ?? "") &&
        reviewsWanted.includes(card.dataset.review ?? "") &&
        (!monthWanted || card.dataset.month === monthWanted) &&
        (!query || (card.dataset.search ?? "").includes(query));
      card.hidden = !matches;
      if (matches) shown += 1;
    }

    if (count) {
      count.textContent = `Showing ${shown} of ${cards.length} races`;
    }
    if (empty) empty.hidden = shown > 0;
  }

  function sortCards(): void {
    if (!list) return;
    const mode = sort?.value ?? "date";
    const visible = cards.filter((card) => !card.hidden);
    const hidden = cards.filter((card) => card.hidden);
    const ordered = [...visible].sort((a, b) =>
      mode === "name"
        ? (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")
        : (a.dataset.date ?? "").localeCompare(b.dataset.date ?? ""),
    );
    for (const card of [...ordered, ...hidden]) list.appendChild(card);
  }

  function applyAndSort(): void {
    apply();
    sortCards();
  }

  function reset(): void {
    if (search) search.value = "";
    if (month) month.value = "";
    if (sort) sort.value = "date";
    for (const input of document.querySelectorAll<HTMLInputElement>(
      "input[type=checkbox]",
    )) {
      input.checked = true;
    }
    applyAndSort();
  }

  search?.addEventListener("input", apply);
  month?.addEventListener("change", apply);
  sort?.addEventListener("change", sortCards);
  document
    .querySelectorAll<HTMLInputElement>("input[type=checkbox]")
    .forEach((input) => input.addEventListener("change", apply));
  document.querySelector("#reset")?.addEventListener("click", reset);
  document.querySelector("#reset-2")?.addEventListener("click", reset);

  window.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "SELECT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable);
    if (event.key === "/" && !typing) {
      event.preventDefault();
      search?.focus();
    } else if (event.key === "Escape" && document.activeElement === search) {
      if (search.value) {
        search.value = "";
        apply();
      } else {
        search.blur();
      }
    }
  });
</script>

<style>
  .filters {
    margin-bottom: 1.5rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1.25rem;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-label {
    display: block;
    margin-bottom: 0.3rem;
    color: #52605b;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .filter-label kbd {
    padding: 0 0.3rem;
    border: 1px solid #d9ded8;
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    background: #f0eee7;
    font-size: 0.7rem;
    letter-spacing: 0;
  }

  .search {
    flex: 1 1 220px;
    min-width: min(220px, 100%);
  }

  .search input {
    width: 100%;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid #d9ded8;
    border-radius: 999px;
    background: #fff;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .chip:hover {
    border-color: #9db8ac;
  }

  .chip:focus-within {
    outline: 2px solid #2f6f5b;
    outline-offset: 2px;
  }

  .chip:has(input:checked) {
    border-color: #2f6f5b;
    background: #e5eee9;
    color: #2f5648;
  }

  .chip input {
    margin: 0;
    accent-color: #2f6f5b;
  }

  input[type="search"],
  select {
    padding: 0.4rem 0.65rem;
    border: 1px solid #d9ded8;
    border-radius: 0.6rem;
    background: #fff;
    font: inherit;
    font-size: 0.9rem;
  }

  input[type="search"]:focus,
  select:focus {
    outline: 2px solid #2f6f5b;
    outline-offset: 1px;
    border-color: #2f6f5b;
  }

  #reset {
    padding: 0.4rem 1rem;
    border: 1px solid #d9ded8;
    border-radius: 999px;
    background: #f0eee7;
    color: #2f5648;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  #reset:hover {
    background: #e5eee9;
  }

  .result-count {
    margin: 0.9rem 0 0;
    color: #52605b;
    font-size: 0.9rem;
  }

  .event-list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-card[hidden] {
    display: none;
  }

  .event-heading h2 {
    text-wrap: balance;
  }

  .event-heading h2 a {
    text-decoration: none;
  }

  .group:hover .event-heading h2 a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-foot {
    margin: 0.7rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .card-foot a {
    text-decoration: none;
  }

  .card-foot a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .generated {
    margin-top: 1.5rem;
    color: #6b7673;
    font-size: 0.85rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
