---
import Base from "../layouts/Base.astro";
import {
  buildDate,
  classifications,
  countries,
  editions,
  editionTotalDays,
  futureEditions,
  generatedAt,
  kinds,
  monthGroups,
  searchHaystack,
  slugForEvent,
} from "../lib/catalog";
import {
  countryFlag,
  formatCourseLabel,
  formatDateCompact,
  formatDateRange,
  formatDistance,
  formatKind,
  formatTimestamp,
  yearOf,
} from "../lib/format";

const months = monthGroups();
const visible = futureEditions;
const maxDistanceOf = (edition: (typeof editions)[number]): number =>
  edition.course_variants.length
    ? Math.max(...edition.course_variants.map((course) => course.distance_km))
    : 0;
const minDistanceOf = (edition: (typeof editions)[number]): number =>
  edition.course_variants.length
    ? Math.min(...edition.course_variants.map((course) => course.distance_km))
    : 0;
const minElevationOf = (edition: (typeof editions)[number]): number => {
  const elevations = edition.course_variants
    .map((course) => course.elevation_m)
    .filter((value): value is number => value !== null);
  return elevations.length ? Math.min(...elevations) : Number.POSITIVE_INFINITY;
};

/** Easiest course variant, with its steepness (elevation per km). */
const easiestCourseOf = (edition: (typeof editions)[number]) => {
  if (edition.course_variants.length === 0) return null;
  const easiest = edition.course_variants.reduce((a, b) =>
    a.distance_km <= b.distance_km ? a : b,
  );
  const steepness = easiest.elevation_m ? easiest.elevation_m / easiest.distance_km : 0;
  return { distance: easiest.distance_km, elevation: easiest.elevation_m, steepness };
};
const distances = visible.map((edition) => maxDistanceOf(edition)).filter((km) => km > 0);
// A linear slider over 2-1400 km would squeeze every real race (30-130 km)
// into 3% of the track. Cap the visual at 200 km; everything above is "200+"
// and matched via the max thumb sitting there.
const distanceBounds: [number, number] = [
  Math.floor(Math.min(...distances)),
  200,
];
---

<Base
  title="All races — MTB Marathon Calendar"
  description="Every mountain bike marathon, ultra and stage race we have collected, filterable by country, format and month."
>
  <section class="toolbar" aria-labelledby="filters-heading">
    <h2 id="filters-heading" class="sr-only">Filter races</h2>

    <div class="toolbar-row">
      <label class="search">
        <span class="sr-only">Search</span>
        <input
          type="search"
          id="search"
          placeholder="Search races…  (press /)"
          autocomplete="off"
        />
      </label>

      <button type="button" id="filters-toggle" aria-expanded="false" aria-controls="filter-panel">
        Filters <span class="filter-badge" id="filter-badge" hidden>0</span>
      </button>

      <label class="select">
        <span class="sr-only">Sort</span>
        <select id="sort" aria-label="Sort races">
          <option value="date">Soonest first</option>
          <option value="name">Name A–Z</option>
        </select>
      </label>
    </div>

    <div class="filter-panel" id="filter-panel" hidden>
      <fieldset>
        <legend class="filter-label">When</legend>
        <div class="chips" role="radiogroup" aria-label="When">
          <label class="chip option">
            <input type="radio" name="when" value="upcoming" checked />
            <span>Upcoming</span>
          </label>
          <label class="chip option">
            <input type="radio" name="when" value="past" />
            <span>Past</span>
          </label>
          <label class="chip option">
            <input type="radio" name="when" value="all" />
            <span>All time</span>
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Class</legend>
        <div class="chips">
          {
            classifications.map((kind) => (
              <label class="chip option">
                <input type="checkbox" name="class" value={kind.value} />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Format</legend>
        <div class="chips">
          {
            kinds.map((kind) => (
              <label class="chip option">
                <input type="checkbox" name="format" value={kind.value} />
                <span>{kind.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Country</legend>
        <div class="chips">
          {
            countries.map((code) => (
              <label class="chip option">
                <input type="checkbox" name="country" value={code} />
                <span>{code}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Distance</legend>
        <div class="range-wrap">
          <div class="range-track" aria-hidden="true">
            <div class="range-fill" id="range-fill"></div>
          </div>
          <input type="range" id="dist-min" min={distanceBounds[0]} max={distanceBounds[1]} step="1" value={distanceBounds[0]} />
          <input type="range" id="dist-max" min={distanceBounds[0]} max={distanceBounds[1]} step="1" value={distanceBounds[1]} />
          <p class="range-values">
            <span id="dist-min-label">{distanceBounds[0]} km</span>
            <span class="range-dash" aria-hidden="true">–</span>
            <span id="dist-max-label">{distanceBounds[1]} km</span>
          </p>
        </div>
      </fieldset>

      <fieldset>
        <legend class="filter-label">Month</legend>
        <label class="select">
          <span class="sr-only">Month</span>
          <select id="month">
            <option value="">All months</option>
            {months.map((group) => <option value={group.key}>{group.label}</option>)}
          </select>
        </label>
      </fieldset>

      <div class="panel-foot">
        <button type="button" id="clear-filters">Clear all</button>
      </div>
    </div>

    <div class="applied" id="applied-filters" hidden>
      <span class="applied-label">Filters:</span>
      <span id="applied-list" />
      <button type="button" id="clear-inline">Clear</button>
    </div>
  </section>

  <p class="result-count" id="result-count" role="status" aria-live="polite">
    {visible.length} races
  </p>

  <ul class="event-list" id="event-list">
    {
      editions.map((edition) => {
        const end = (edition as { date_end?: string | null }).date_end ?? edition.date_start;
        const days = editionTotalDays(edition);
        return (
          <li
            class="event-card"
            data-country={edition.location.country}
            data-format={edition.format}
            data-class={edition.classification}
            data-month={edition.date_start.slice(0, 7)}
            data-review={edition.review.status}
            data-search={searchHaystack(edition)}
            data-name={edition.name.toLowerCase()}
            data-date={edition.date_start}
            data-end={end}
            data-max={maxDistanceOf(edition)}
            data-min={minDistanceOf(edition)}
            data-elev={minElevationOf(edition)}
            data-steep={easiestCourseOf(edition)?.steepness ?? ""}
            data-lat={edition.location.lat ?? ""}
            data-lng={edition.location.lng ?? ""}
          >
            <div class="rail" aria-hidden="true">
              <span class="flag">{countryFlag(edition.location.country)}</span>
              <span class="rail-date">{formatDateCompact(edition.date_start)}</span>
              <span class="rail-year">{yearOf(edition.date_start)}</span>
            </div>

            <div class="card-body">
              <div class="event-heading">
                <h2>
                  <a href={`/events/${slugForEvent(edition.event_id)}/${edition.edition}`}>{edition.name}</a>
                </h2>
                <div class="heading-badges">
                  <span class="badge kind">{formatKind(edition.format)}</span>
                  {days > 1 && <span class="days-pill">{days} days</span>}
                  {edition.classification === "mtb_ultra" && (
                    <span class="badge ultra">Ultra</span>
                  )}
                  <button
                    type="button"
                    class="pin-btn"
                    data-pin={edition.id}
                    aria-pressed="false"
                    aria-label={`Pin ${edition.name}`}
                    title="Pin for the planner"
                  >
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M8 1.5 9.8 5.6l4.5.4-3.4 3 1 4.4L8 11.2l-3.9 2.2 1-4.4-3.4-3 4.5-.4L8 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    </svg>
                  </button>
                </div>
              </div>

              <p class="event-meta">
                <span>
                  {edition.location.name}
                  {edition.location.region ? `, ${edition.location.region}` : ""}
                  {edition.course_variants.length > 0 &&
                    ` · up to ${formatDistance(
                      Math.max(
                        ...edition.course_variants.map((course) => course.distance_km),
                      ),
                    )}`}
                </span>
                <a href={edition.official_url} target="_blank" rel="noopener noreferrer">Official page ↗</a>
              </p>

              {edition.course_variants.length > 1 && (
                <ul class="course-list">
                  {edition.course_variants.map((course) => (
                    <li>
                      {formatCourseLabel(course.name, course.distance_km)}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>

  <p class="empty" id="no-results" hidden>
    No races match those filters. <button type="button" id="reset-2">Clear them</button>
  </p>

  <p class="generated">Data collected {formatTimestamp(generatedAt)}.</p>
</Base>

<script>
  const list = document.querySelector<HTMLUListElement>("#event-list");
  const cards = Array.from(list?.querySelectorAll<HTMLElement>(".event-card") ?? []);
  const search = document.querySelector<HTMLInputElement>("#search");
  const month = document.querySelector<HTMLSelectElement>("#month");
  const sort = document.querySelector<HTMLSelectElement>("#sort");
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#no-results");
  const panel = document.querySelector<HTMLElement>("#filter-panel");
  const toggle = document.querySelector<HTMLButtonElement>("#filters-toggle");
  const badge = document.querySelector<HTMLElement>("#filter-badge");
  const appliedBox = document.querySelector<HTMLElement>("#applied-filters");
  const appliedList = document.querySelector<HTMLElement>("#applied-list");
  const distMin = document.querySelector<HTMLInputElement>("#dist-min");
  const distMax = document.querySelector<HTMLInputElement>("#dist-max");
  const rangeFill = document.querySelector<HTMLElement>("#range-fill");
  const distMinLabel = document.querySelector<HTMLElement>("#dist-min-label");
  const distMaxLabel = document.querySelector<HTMLElement>("#dist-max-label");

  const today = new Date().toISOString().slice(0, 10);
  const isPast = (card: HTMLElement): boolean => (card.dataset.end ?? "") < today;

  const checked = (name: string): string[] =>
    Array.from(
      document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`),
    ).map((input) => input.value);

  // Filter semantics: nothing checked in a group = that group is inactive
  // (show everything). Checking values restricts to them. This matches how
  // modern faceted search works: filters are opt-in restrictions.
  function apply(): void {
    const countriesWanted = checked("country");
    const formatsWanted = checked("format");
    const classesWanted = checked("class");
    const when = (
      document.querySelector<HTMLInputElement>('input[name="when"]:checked')?.value ?? "upcoming"
    );
    const monthWanted = month?.value ?? "";
    const query = (search?.value ?? "").trim().toLowerCase();
    const minKm = distMin ? Number(distMin.value) : 0;
    const maxKm = distMax ? Number(distMax.value) : Infinity;

    const geo = window.__geo;
    const holiday = window.__holiday;

    let shown = 0;
    let anyFilterActive = false;
    for (const card of cards) {
      const cardMax = Number(card.dataset.max ?? 0);
      // A race without distance data (max 0) must not be excluded by the
      // slider: missing data never excludes (site-wide principle).
      const cardKm = cardMax > 0 ? Math.min(cardMax, 200) : null;
      let matches =
        (countriesWanted.length === 0 || countriesWanted.includes(card.dataset.country ?? "")) &&
        (formatsWanted.length === 0 || formatsWanted.includes(card.dataset.format ?? "")) &&
        (classesWanted.length === 0 || classesWanted.includes(card.dataset.class ?? "")) &&
        (!monthWanted || card.dataset.month === monthWanted) &&
        (!query || (card.dataset.search ?? "").includes(query)) &&
        (when === "all" ||
          (when === "past" ? isPast(card) : !isPast(card))) &&
        (cardKm === null || (cardKm >= minKm && cardKm <= maxKm));

      // Holiday window: race overlaps [from, until].
      if (matches && holiday && (holiday.from || holiday.until)) {
        const start = card.dataset.date ?? "";
        const end = card.dataset.end ?? start;
        if (holiday.from && end < holiday.from) matches = false;
        if (holiday.until && start > holiday.until) matches = false;
      }

      // Beginner fit: the easiest course must actually be easy. Steepness
      // (elevation per km on the shortest variant) keeps the Dolomites-style
      // races out; the ceiling keeps 100 km ultras out. Races without
      // elevation data are kept — the gap is shown, not guessed.
      if (matches && window.__fit === "beginner") {
        const steepRaw = card.dataset.steep;
        const easiestKm = Number(card.dataset.min ?? 0);
        if (steepRaw !== "" && Number(steepRaw) > 30) matches = false;
        if (easiestKm > 55) matches = false;
      }

      // Near me: haversine in the browser, nothing sent anywhere.
      if (matches && geo) {
        const cardLat = Number(card.dataset.lat);
        const cardLng = Number(card.dataset.lng);
        if (Number.isFinite(cardLat) && Number.isFinite(cardLng)) {
          const dLat = ((cardLat - geo.lat) * Math.PI) / 180;
          const dLng = ((cardLng - geo.lng) * Math.PI) / 180;
          const h =
            Math.sin(dLat / 2) ** 2 +
            Math.cos((geo.lat * Math.PI) / 180) *
              Math.cos((cardLat * Math.PI) / 180) *
              Math.sin(dLng / 2) ** 2;
          const km = 2 * 6371 * Math.asin(Math.sqrt(h));
          matches = km <= geo.radius;
        } else {
          matches = false;
        }
      }

      card.hidden = !matches;
      if (matches) shown += 1;
    }

    anyFilterActive =
      query !== "" ||
      monthWanted !== "" ||
      countriesWanted.length > 0 ||
      formatsWanted.length > 0 ||
      classesWanted.length > 0 ||
      when !== "upcoming" ||
      rangeActive();

    if (count) {
      count.textContent = `${shown} of ${cards.length} races`;
    }
    if (empty) empty.hidden = shown > 0;
    if (badge) {
      badge.hidden = !anyFilterActive;
      badge.textContent = String(
        (query ? 1 : 0) +
          (monthWanted ? 1 : 0) +
          (countriesWanted.length ? 1 : 0) +
          (formatsWanted.length ? 1 : 0) +
          (classesWanted.length ? 1 : 0) +
          (when !== "upcoming" ? 1 : 0),
      );
    }
    renderApplied();
  }

  function renderApplied(): void {
    if (!appliedBox || !appliedList) return;
    const lozenges: string[] = [];
    const query = (search?.value ?? "").trim();
    if (query) lozenges.push(`“${query}”`);
    const when = document.querySelector<HTMLInputElement>('input[name="when"]:checked')?.value;
    if (when && when !== "upcoming") {
      lozenges.push(when === "past" ? "Past" : "All time");
    }
    for (const name of ["class", "format", "country"]) {
      for (const value of checked(name)) {
        const label =
          document.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`)
            ?.closest("label")
            ?.querySelector("span")
            ?.textContent ?? value;
        lozenges.push(label);
      }
    }
    const monthWanted = month?.value;
    if (monthWanted) {
      const label = month.selectedOptions[0]?.textContent ?? monthWanted;
      lozenges.push(label);
    }
    if (rangeActive() && distMinLabel && distMaxLabel) {
      lozenges.push(`${distMinLabel.textContent} – ${distMaxLabel.textContent}`);
    }
    appliedBox.hidden = lozenges.length === 0;
    appliedList.replaceChildren(
      ...lozenges.map((text) => {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "lozenge";
        chip.textContent = text;
        return chip;
      }),
    );
  }

  // Lozenges remove one filter each.
  appliedList?.addEventListener("click", (event) => {
    const chip = (event.target as HTMLElement).closest("button.lozenge");
    if (!chip) return;
    const text = chip.textContent ?? "";
    const searchInput = search;
    if (searchInput && text.startsWith("“")) {
      searchInput.value = "";
    } else if (text === "Past" || text === "All time") {
      const radio = document.querySelector<HTMLInputElement>('input[name="when"][value="upcoming"]');
      if (radio) radio.checked = true;
    } else if (text === month?.selectedOptions[0]?.textContent) {
      month.value = "";
    } else if (/km/.test(text) && distMin && distMax) {
      distMin.value = distMin.min;
      distMax.value = distMax.max;
      clampRange();
    } else {
      const checkbox = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
      ).find((input) => input.closest("label")?.querySelector("span")?.textContent === text);
      if (checkbox) checkbox.checked = false;
    }
    apply();
  });

  function clearAll(): void {
    if (search) search.value = "";
    if (month) month.value = "";
    if (distMin && distMax) {
      distMin.value = distMin.min;
      distMax.value = distMax.max;
      clampRange();
    }
    for (const input of document.querySelectorAll<HTMLInputElement>(
      'input[name="class"], input[name="format"], input[name="country"]',
    )) {
      input.checked = false;
    }
    const upcoming = document.querySelector<HTMLInputElement>('input[name="when"][value="upcoming"]');
    if (upcoming) upcoming.checked = true;
    apply();
  }

  toggle?.addEventListener("click", () => {
    const open = panel?.hidden ?? false;
    if (panel) panel.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
  });

  search?.addEventListener("input", apply);
  month?.addEventListener("change", apply);
  sort?.addEventListener("change", sortCards);
  document
    .querySelectorAll<HTMLInputElement>('input[name="class"], input[name="format"], input[name="country"], input[name="when"]')
    .forEach((input) => input.addEventListener("change", apply));
  document.querySelector("#clear-filters")?.addEventListener("click", clearAll);
  document.querySelector("#clear-inline")?.addEventListener("click", clearAll);
  document.querySelector("#reset-2")?.addEventListener("click", clearAll);

  function clampRange(): void {
    if (!distMin || !distMax) return;
    let low = Number(distMin.value);
    let high = Number(distMax.value);
    if (low > high) {
      [low, high] = [high, low];
      distMin.value = String(low);
      distMax.value = String(high);
    }
    const lo = Number(distMin.min);
    const hi = Number(distMin.max);
    if (rangeFill) {
      rangeFill.style.left = `${((low - lo) / (hi - lo)) * 100}%`;
      rangeFill.style.width = `${((high - low) / (hi - lo)) * 100}%`;
    }
    if (distMinLabel) distMinLabel.textContent = `${low} km`;
    if (distMaxLabel) distMaxLabel.textContent = high >= hi ? `${hi} km+` : `${high} km`;
  }

  function rangeActive(): boolean {
    if (!distMin || !distMax) return false;
    return Number(distMin.value) > Number(distMin.min) || Number(distMax.value) < Number(distMin.max);
  }

  distMin?.addEventListener("input", () => {
    clampRange();
    apply();
  });
  distMax?.addEventListener("input", () => {
    clampRange();
    apply();
  });

  function sortCards(): void {
    if (!list) return;
    const mode = sort?.value ?? "date";
    const visible = cards.filter((card) => !card.hidden);
    const hidden = cards.filter((card) => card.hidden);
    const ordered = [...visible].sort((a, b) => {
      if (mode === "name") {
        return (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "");
      }
      if (mode === "easiest") {
        // Rank beginner-relevant: gentlest easiest-course first, then shortest.
        const sa = Number(a.dataset.steep ?? Number.POSITIVE_INFINITY);
        const sb = Number(b.dataset.steep ?? Number.POSITIVE_INFINITY);
        if (sa !== sb) return sa - sb;
        return Number(a.dataset.min ?? 0) - Number(b.dataset.min ?? 0);
      }
      return (a.dataset.date ?? "").localeCompare(b.dataset.date ?? "");
    });
    for (const card of [...ordered, ...hidden]) list.appendChild(card);
  }

  window.addEventListener("keydown", (event) => {
    const target = event.target as HTMLElement | null;
    const typing =
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "SELECT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable);
    if (event.key === "/" && !typing) {
      event.preventDefault();
      search?.focus();
    } else if (event.key === "Escape" && document.activeElement === search) {
      if (search.value) {
        search.value = "";
        apply();
      } else {
        search.blur();
      }
    }
  });

  clampRange();
  function refreshPins(): void {
    const pins = JSON.parse(localStorage.getItem("mtb-pinned-editions") ?? "[]") as string[];
    for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-pin]")) {
      const pressed = pins.includes(button.dataset.pin ?? "");
      button.setAttribute("aria-pressed", String(pressed));
    }
    const badge = document.querySelector<HTMLElement>("#planner-count");
    if (badge) badge.textContent = String(pins.length);
  }

  document.querySelectorAll<HTMLButtonElement>("button[data-pin]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.pin ?? "";
      const pins = JSON.parse(localStorage.getItem("mtb-pinned-editions") ?? "[]") as string[];
      const next = pins.includes(id) ? pins.filter((pin) => pin !== id) : [...pins, id];
      localStorage.setItem("mtb-pinned-editions", JSON.stringify(next));
      window.dispatchEvent(new CustomEvent("mtb:pins-changed"));
    });
  });
  window.addEventListener("mtb:pins-changed", refreshPins);
  refreshPins();

  // Guided finders (see /finder) land here with URL params; apply them as
  // filters, then rank the results for the question asked.
  function applyFinderParams(): void {
    const params = new URLSearchParams(window.location.search);
    const lat = params.get("lat");
    const lng = params.get("lng");
    const radius = params.get("radius");
    const from = params.get("from");
    const until = params.get("until");
    const country = params.get("country");
    const fit = params.get("fit");

    // Holiday window: When=All time + date bounds via card dataset.
    if (from || until) {
      const allTime = document.querySelector<HTMLInputElement>('input[name="when"][value="all"]');
      if (allTime) allTime.checked = true;
      window.__holiday = { from, until };
    }
    if (country) {
      // Restrict the country chips to the requested one.
      for (const input of document.querySelectorAll<HTMLInputElement>('input[name="country"]')) {
        input.checked = input.value === country;
      }
    }
    if (lat && lng) {
      window.__geo = { lat: Number(lat), lng: Number(lng), radius: Number(radius ?? 100) };
    }
    if (fit === "beginner") {
      window.__fit = "beginner";
      // Beginner default: only single-day, sort by easiest course.
      for (const input of document.querySelectorAll<HTMLInputElement>('input[name="format"]')) {
        input.checked = input.value === "single_day";
      }
      if (sort) sort.value = "easiest";
      const easiest = document.querySelector<HTMLOptionElement>('select#sort option[value="easiest"]');
      if (!easiest && sort) {
        const option = document.createElement("option");
        option.value = "easiest";
        option.textContent = "Easiest first";
        sort.append(option);
        sort.value = "easiest";
      }
    }
  }

  declare global {
    interface Window {
      __geo?: { lat: number; lng: number; radius: number };
      __holiday?: { from: string | null; until: string | null };
