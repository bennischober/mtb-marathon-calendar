---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/urls";
---

<Base
  title="Planner — MTB Marathon Calendar"
  description="Your pinned races, arranged into a trip plan."
>
  <section class="planner-head">
    <div class="head-row">
      <h1>Your trip planner</h1>
      <p class="count-line" id="plan-count" hidden>
        <strong id="plan-count-n">0</strong>
        <span id="plan-count-label">races pinned</span>
        <button type="button" class="clear-all" id="clear-all" hidden>
          Unpin all
        </button>
      </p>
    </div>
    <p class="lede-line">
      Pin races in the <a href={withBase("/")}>list</a> or <a href={withBase("/calendar")}>calendar</a>{" "}
      (star button) and they build up here — stored in your browser, no account.
    </p>
  </section>

  <p class="empty-plan" id="empty-plan">
    <span class="empty-icon" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 16 16" fill="none">
        <path
          d="M8 1.5 9.8 5.6l4.5.4-3.4 3 1 4.4L8 11.2l-3.9 2.2 1-4.4-3.4-3 4.5-.4L8 1.5Z"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    Nothing pinned yet.
    <span class="empty-hint">Find a race and press the star — this page becomes your trip plan.</span>
  </p>

  <div id="plan-groups" class="plan-groups"></div>
</Base>

<script>
  import { editionById, editionUrl, nearbyEditions } from "../lib/catalog";
  import {
    countryFlag,
    formatDateRange,
    formatDistance,
    formatKind,
  } from "../lib/format";

  interface PlanRow {
    id: string;
    name: string;
    flag: string;
    startDate: string;
    when: string;
    where: string;
    region: string;
    country: string;
    kind: string;
    maxKm: number | null;
    href: string;
  }

  function readPinIds(): string[] {
    try {
      const ids = JSON.parse(localStorage.getItem("mtb-pinned-editions") ?? "[]");
      return Array.isArray(ids) ? ids.filter((id) => typeof id === "string") : [];
    } catch {
      return [];
    }
  }

  function readPins(): PlanRow[] {
    const rows: PlanRow[] = [];
    for (const id of readPinIds()) {
      const edition = editionById(id);
      if (!edition) continue;
      const maxKm = edition.course_variants.length
        ? Math.max(...edition.course_variants.map((course) => course.distance_km))
        : null;
      rows.push({
        id: edition.id,
        name: edition.name,
        flag: countryFlag(edition.location.country),
        startDate: edition.date_start,
        when: formatDateRange(edition.date_start, edition.date_end ?? undefined),
        where: edition.location.name,
        region: edition.location.region ?? "",
        country: edition.location.country,
        kind: formatKind(edition.format),
        maxKm,
        href: editionUrl(edition),
      });
    }
    return rows.sort((a, b) => a.startDate.localeCompare(b.startDate));
  }

  function unpin(id: string): void {
    localStorage.setItem(
      "mtb-pinned-editions",
      JSON.stringify(readPinIds().filter((pin) => pin !== id)),
    );
    window.dispatchEvent(new CustomEvent("mtb:pins-changed"));
  }

  function planCard(row: PlanRow): HTMLElement {
    const card = document.createElement("article");
    card.className = "plan-card";

    // Rail: flag + start day, the scan pattern from the list.
    const rail = document.createElement("div");
    rail.className = "plan-rail";
    rail.setAttribute("aria-hidden", "true");
    const flag = document.createElement("span");
    flag.className = "plan-flag";
    flag.textContent = row.flag;
    const day = document.createElement("span");
    day.className = "plan-day";
    day.textContent = row.startDate.slice(8, 10);
    const month = document.createElement("span");
    month.className = "plan-month";
    month.textContent = new Date(`${row.startDate}T00:00:00Z`).toLocaleDateString("en-GB", {
      month: "short",
      timeZone: "UTC",
    });
    rail.append(flag, day, month);

    const body = document.createElement("div");
    body.className = "plan-body";

    const head = document.createElement("div");
    head.className = "plan-head";
    const title = document.createElement("a");
    title.href = row.href;
    title.textContent = row.name;
    head.append(title);

    const unpinButton = document.createElement("button");
    unpinButton.type = "button";
    unpinButton.className = "unpin";
    unpinButton.setAttribute("aria-label", `Remove ${row.name} from the plan`);
    unpinButton.innerHTML = `<svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`;
    unpinButton.addEventListener("click", () => unpin(row.id));
    head.append(unpinButton);

    const facts = document.createElement("p");
    facts.className = "plan-facts";
    facts.textContent = [
      row.when,
      `${row.where}${row.region ? `, ${row.region}` : ""}`,
      row.kind,
      row.maxKm !== null ? `up to ${formatDistance(row.maxKm)}` : null,
    ]
      .filter(Boolean)
      .join(" · ");

    body.append(head, facts);

    // "While you're there": nearby races not yet pinned.
    const edition = editionById(row.id);
    if (edition) {
      const pinned = new Set(readPinIds());
      const suggestions = nearbyEditions(edition, { windowDays: 7, limit: 3 })
        .filter((entry) => !pinned.has(entry.edition.id));
      if (suggestions.length > 0) {
        const box = document.createElement("div");
        box.className = "plan-nearby";
        const label = document.createElement("span");
        label.className = "plan-nearby-label";
        label.textContent = "While you're there";
        const links = document.createElement("p");
        suggestions.forEach((entry, index) => {
          if (index > 0) links.append(", ");
          const link = document.createElement("a");
          link.href = editionUrl(entry.edition);
          link.textContent = entry.edition.name;
          links.append(link);
        });
        box.append(label, links);
        body.append(box);
      }
    }

    card.append(rail, body);
    return card;
  }

  function render(): void {
    const groups = document.querySelector<HTMLElement>("#plan-groups");
    const empty = document.querySelector<HTMLElement>("#empty-plan");
    const countLine = document.querySelector<HTMLElement>("#plan-count");
    const countN = document.querySelector<HTMLElement>("#plan-count-n");
    const countLabel = document.querySelector<HTMLElement>("#plan-count-label");
    const clearAll = document.querySelector<HTMLButtonElement>("#clear-all");
    if (!groups || !empty || !countLine || !countN || !countLabel || !clearAll) return;

    const rows = readPins();
    groups.replaceChildren();
    empty.hidden = rows.length > 0;
    countLine.hidden = rows.length === 0;
    clearAll.hidden = rows.length === 0;
    countN.textContent = String(rows.length);
    countLabel.textContent = rows.length === 1 ? "race pinned" : "races pinned";

    clearAll.onclick = () => {
      localStorage.setItem("mtb-pinned-editions", "[]");
      window.dispatchEvent(new CustomEvent("mtb:pins-changed"));
    };

    for (const row of rows) groups.append(planCard(row));
  }

  window.addEventListener("mtb:pins-changed", render);
  render();
</script>

<style>
  .planner-head {
    margin-bottom: 1.4rem;
  }

  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }

  .planner-head h1 {
    margin: 0;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    letter-spacing: -0.02em;
  }

  .count-line {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .count-line strong {
    color: var(--accent);
    font-size: 1.05rem;
  }

  .clear-all {
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface);
    color: var(--danger);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .clear-all:hover {
    background: color-mix(in srgb, var(--danger) 10%, transparent);
    border-color: #d9a0a0;
  }

  .lede-line {
    margin: 0.25rem 0 0;
    color: var(--text-mute);
    font-size: 0.95rem;
  }

  .empty-plan {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    max-width: 26rem;
    margin: 2.5rem auto 0;
    padding: 2.4rem 2rem;
    border: 1px dashed var(--hairline);
    border-radius: 1rem;
    color: var(--text-soft);
    text-align: center;
  }

  .empty-icon {
    color: #b3bab4;
  }

  .empty-hint {
    color: var(--text-mute);
    font-size: 0.88rem;
  }

  .plan-groups {
    display: grid;
    gap: 0.75rem;
  }

  .plan-card {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 0.9rem;
    background: var(--surface);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--text) 5%, transparent);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .plan-card:hover {
    border-color: #c8c3b6;
    box-shadow: 0 6px 20px -12px color-mix(in srgb, var(--text) 35%, transparent);
  }

  .plan-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.85rem 0.5rem;
    border-right: 1px solid var(--hairline-soft);
    background: var(--bg-soft);
  }

  .plan-flag {
    font-size: 1.5rem;
    line-height: 1.1;
  }

  .plan-day {
    margin-top: 0.3rem;
    color: var(--text);
    font-size: 1rem;
    font-weight: 800;
  }

  .plan-month {
    color: var(--text-mute);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .plan-body {
    padding: 0.85rem 1.1rem 0.95rem;
    min-width: 0;
  }

  .plan-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .plan-head a {
    color: var(--text);
    font-weight: 750;
    font-size: 1.08rem;
    text-decoration: none;
    text-wrap: balance;
  }

  .plan-head a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .unpin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-mute);
    cursor: pointer;
    transition: color 0.12s ease, border-color 0.12s ease, background 0.12s ease;
  }

  .unpin:hover {
    color: var(--danger);
    border-color: #d9a0a0;
    background: color-mix(in srgb, var(--danger) 10%, transparent);
  }

  .plan-facts {
    margin: 0.3rem 0 0;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .plan-nearby {
    margin: 0.65rem 0 0;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--hairline-soft);
    border-radius: 0.55rem;
    background: var(--bg-soft);
  }

  .plan-nearby-label {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--text-mute);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plan-nearby p {
    margin: 0;
    font-size: 0.88rem;
  }

  .plan-nearby a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
  }

  .plan-nearby a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .plan-card {
      grid-template-columns: 4.6rem minmax(0, 1fr);
    }

    .plan-flag {
      font-size: 1.25rem;
    }
  }
</style>
