---
import Base from "../layouts/Base.astro";
import { seriesIndex } from "../lib/catalog";
import { countryFlag, formatDate, formatDateRange } from "../lib/format";
import { withBase } from "../lib/urls";

// The archive: every known race series with all its editions, past included.
// The main list stays upcoming-only; history lives here, grouped per series.
const series = seriesIndex();
const totalEditions = series.reduce((sum, entry) => sum + entry.editions.length, 0);
const allYears = [...new Set(series.flatMap((entry) => entry.editions.map((e) => e.edition)))].sort(
  (a, b) => b - a,
);
---

<Base
  title="Archive — MTB Marathon Calendar"
  description="Every race series we know, with all collected editions past and future."
>
  <section class="archive-head">
    <h1>Race archive</h1>
    <p class="sub">
      {series.length} race series, {totalEditions} collected editions — past
      and future. The <a href={withBase("/")}>main list</a> shows upcoming races only.
    </p>
  </section>

  <section class="archive-filters" aria-label="Filter the archive">
    <label class="search">
      <span class="sr-only">Search races</span>
      <input type="search" id="archive-search" placeholder="Search races or places…" autocomplete="off" />
    </label>
    <div class="chips" id="year-chips">
      <label class="chip option">
        <input type="radio" name="archive-year" value="" checked />
        <span>All years</span>
      </label>
      {allYears.map((year) => (
        <label class="chip option">
          <input type="radio" name="archive-year" value={String(year)} />
          <span>{year}</span>
        </label>
      ))}
    </div>
    <p class="result-line" id="archive-count" role="status" aria-live="polite">
      {series.length} series
    </p>
  </section>

  <ul class="series-list" id="series-list">
    {
      series.map((entry) => (
        <li
          class="series-row"
          data-search={`${entry.name} ${entry.latest.location.name} ${entry.latest.location.region ?? ""} ${entry.country}`.toLowerCase()}
          data-years={entry.editions.map((e) => e.edition).join(" ")}
        >
          <div class="series-rail" aria-hidden="true">
            <span class="flag">{countryFlag(entry.country)}</span>
            <span class="years">
              {entry.firstYear === entry.lastYear
                ? entry.firstYear
                : `${entry.firstYear}–${entry.lastYear}`}
            </span>
          </div>
          <div class="series-body">
            <div class="series-head">
              <h2>
                <a href={withBase(`/events/${entry.slug}`)}>{entry.name}</a>
              </h2>
              {entry.pastCount > 0 && (
                <span class="edition-count">{entry.pastCount} past</span>
              )}
            </div>
            <ul class="edition-list">
              {[...entry.editions].reverse().map((edition) => (
                <li>
                  <a href={withBase(`/events/${entry.slug}/${edition.edition}`)}>
                    <strong>{edition.edition}</strong>
                    {formatDateRange(edition.date_start, edition.date_end ?? undefined)}
                    <span class="place">
                      {edition.location.name}
                      {(edition as { date_end?: string | null }).date_end ? "" : ""}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</Base>

<script>
  const rows = Array.from(
    document.querySelectorAll<HTMLElement>("#series-list .series-row"),
  );
  const search = document.querySelector<HTMLInputElement>("#archive-search");
  const count = document.querySelector<HTMLElement>("#archive-count");

  function apply(): void {
    const query = (search?.value ?? "").trim().toLowerCase();
    const year = document.querySelector<HTMLInputElement>('input[name="archive-year"]:checked')?.value ?? "";
    let shown = 0;
    for (const row of rows) {
      const matches =
        (!query || (row.dataset.search ?? "").includes(query)) &&
        (!year || (row.dataset.years ?? "").split(" ").includes(year));
      row.hidden = !matches;
      if (matches) shown += 1;
    }
    if (count) count.textContent = `${shown} series`;
  }

  search?.addEventListener("input", apply);
  document
    .querySelectorAll<HTMLInputElement>('input[name="archive-year"]')
    .forEach((input) => input.addEventListener("change", apply));
</script>

<style>
  .archive-head {
    margin-bottom: 1.4rem;
  }

  .archive-head h1 {
    margin: 0 0 0.3rem;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    letter-spacing: -0.02em;
  }

  .sub {
    margin: 0;
    color: var(--text-mute);
    font-size: 0.95rem;
  }

  .archive-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-bottom: 1.1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 0.9rem;
    background: var(--surface)
    box-shadow: 0 1px 2px color-mix(in srgb, var(--text) 4%, transparent);
  }

  .archive-filters .search {
    flex: 1 1 240px;
    min-width: min(240px, 100%);
  }

  .archive-filters .search input {
    width: 100%;
    height: 2.5rem;
    padding: 0 0.8rem;
    border: 1px solid var(--hairline);
    border-radius: 0.6rem;
    background: var(--surface)
    font: inherit;
    font-size: 0.92rem;
  }

  .archive-filters .search input:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--surface)
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .chip:hover {
    border-color: #9db8ac;
  }

  .chip:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-weight: 700;
  }

  .chip input {
    margin: 0;
    accent-color: var(--accent);
  }

  .result-line {
    margin: 0 0 0 auto;
    color: var(--text-soft);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .series-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 0.9rem;
    background: var(--surface)
    box-shadow: 0 1px 2px color-mix(in srgb, var(--text) 5%, transparent);
  }

  .series-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.9rem 0.5rem;
    border-right: 1px solid var(--hairline-soft);
    background: var(--bg-soft);
  }

  .series-rail .flag {
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .series-rail .years {
    color: var(--text-soft);
    font-size: 0.8rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .series-body {
    padding: 0.85rem 1.15rem 0.95rem;
    min-width: 0;
  }

  .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
  }

  .series-head h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }

  .series-head h2 a {
    color: var(--text);
    text-decoration: none;
  }

  .series-head h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .edition-count {
    color: var(--text-mute);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .edition-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .edition-list li {
    padding: 0.18rem 0.6rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--bg-tint);
  }

  .edition-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--text-soft);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .edition-list a:hover {
    border-color: #9db8ac;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .edition-list strong {
    color: var(--accent);
    font-weight: 800;
  }

  .edition-list .place {
    color: var(--text-mute);
    font-size: 0.75rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .series-row {
      grid-template-columns: 4.6rem minmax(0, 1fr);
    }

    .series-rail .flag {
      font-size: 1.25rem;
    }
  }
</style>
